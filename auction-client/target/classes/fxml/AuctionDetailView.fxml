<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vn.edu.vnu.uet.group8.client.controller.AuctionDetailController"
      style="-fx-background-color: #F8F8F8;"
      spacing="0">

    <!-- NÚT QUAY LẠI -->
    <HBox style="-fx-padding: 16 24 8 24;">
        <Button text="← Quay lại danh sách" onAction="#onBack"
                style="-fx-background-color: transparent; -fx-text-fill: #666; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 6 0;"/>
    </HBox>

    <!-- NỘI DUNG CHÍNH -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
        <content>
            <HBox spacing="20" style="-fx-padding: 0 24 24 24;">

                <!-- CỘT TRÁI -->
                <VBox spacing="12" HBox.hgrow="ALWAYS">

                    <!-- Ảnh chính -->
                    <StackPane style="-fx-background-color: #FFF3EB; -fx-background-radius: 12;" prefHeight="220">
                        <ImageView fx:id="imgMain" fitWidth="300" fitHeight="220"
                                   preserveRatio="true"/>
                        <Label fx:id="lblCategory" text="Đồng hồ cao cấp"
                               style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-font-size: 10px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 3 10;"
                               StackPane.alignment="TOP_LEFT">
                            <StackPane.margin><Insets top="8" left="8"/></StackPane.margin>
                        </Label>
                        <HBox spacing="6" StackPane.alignment="TOP_RIGHT" maxWidth="-Infinity" maxHeight="-Infinity">
                             <StackPane.margin><Insets top="8" right="8"/></StackPane.margin>
                             <Button text="♥" onAction="#onFavorite"
                                    style="-fx-background-color: white; -fx-background-radius: 50; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 4 8; -fx-min-width: 32; -fx-min-height: 32;"/>
                             <Button text="⤴" onAction="#onShare"
                                    style="-fx-background-color: white; -fx-background-radius: 50; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 4 8; -fx-min-width: 32; -fx-min-height: 32;"/>
                        </HBox>
                    </StackPane>

                    <!-- Ảnh thumbnail -->
                    <HBox spacing="8">
                        <Button fx:id="btnThumb1" onAction="#onThumb1"
                                style="-fx-background-color: #FFF3EB; -fx-background-radius: 8; -fx-border-color: #F97316; -fx-border-radius: 8; -fx-border-width: 2; -fx-pref-width: 60; -fx-pref-height: 50; -fx-cursor: hand;"/>
                        <Button fx:id="btnThumb2" onAction="#onThumb2"
                                style="-fx-background-color: #F5F5F5; -fx-background-radius: 8; -fx-pref-width: 60; -fx-pref-height: 50; -fx-cursor: hand;"/>
                        <Button fx:id="btnThumb3" onAction="#onThumb3"
                                style="-fx-background-color: #F5F5F5; -fx-background-radius: 8; -fx-pref-width: 60; -fx-pref-height: 50; -fx-cursor: hand;"/>
                    </HBox>

                    <!-- TABS MÔ TẢ -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #EEEEEE; -fx-border-radius: 12; -fx-background-radius: 12;">

                        <!-- Tab buttons -->
                        <HBox>
                            <Button fx:id="btnTabDesc" text="Mô tả" onAction="#onTabDesc"
                                    maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                    style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 12 0 0 0; -fx-padding: 10; -fx-cursor: hand;"/>
                            <Button fx:id="btnTabSpec" text="Thông số" onAction="#onTabSpec"
                                    maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                    style="-fx-background-color: #F5F5F5; -fx-text-fill: #666; -fx-font-size: 12px; -fx-background-radius: 0; -fx-padding: 10; -fx-cursor: hand;"/>
                            <Button fx:id="btnTabOrigin" text="Nguồn gốc" onAction="#onTabOrigin"
                                    maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                    style="-fx-background-color: #F5F5F5; -fx-text-fill: #666; -fx-font-size: 12px; -fx-background-radius: 0 12 0 0; -fx-padding: 10; -fx-cursor: hand;"/>
                        </HBox>

                        <!-- Nội dung tab -->
                        <VBox style="-fx-padding: 14;">
                            <!-- Tab Mô tả -->
                            <VBox fx:id="paneDesc" spacing="8">
                                <Label fx:id="lblDescription" text="Đồng hồ Rolex Submariner cổ điển từ thập niên 1960, được bảo quản trong tình trạng tuyệt vời."
                                       wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #333;"/>
                                <Label text="Tình trạng" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                                <Label fx:id="lblCondition" text="Tuyệt vời - đã qua phục chế chuyên nghiệp"
                                       style="-fx-font-size: 13px; -fx-text-fill: #666;"/>
                            </VBox>

                            <!-- Tab Thông số -->
                            <VBox fx:id="paneSpec" spacing="8" visible="false" managed="false">
                                <HBox><Label text="Thương hiệu" style="-fx-font-size: 12px; -fx-text-fill: #888; -fx-pref-width: 120;"/><Label fx:id="lblBrand" text="Rolex" style="-fx-font-size: 12px;"/></HBox>
                                <HBox><Label text="Model" style="-fx-font-size: 12px; -fx-text-fill: #888; -fx-pref-width: 120;"/><Label fx:id="lblModel" text="Submariner 5513" style="-fx-font-size: 12px;"/></HBox>
                                <HBox><Label text="Năm sản xuất" style="-fx-font-size: 12px; -fx-text-fill: #888; -fx-pref-width: 120;"/><Label fx:id="lblYear" text="1965" style="-fx-font-size: 12px;"/></HBox>
                                <HBox><Label text="Chất liệu" style="-fx-font-size: 12px; -fx-text-fill: #888; -fx-pref-width: 120;"/><Label fx:id="lblMaterial" text="Vàng 18k" style="-fx-font-size: 12px;"/></HBox>
                            </VBox>

                            <!-- Tab Nguồn gốc -->
                            <VBox fx:id="paneOrigin" spacing="8" visible="false" managed="false">
                                <Label fx:id="lblOrigin" text="Xuất xứ từ Thụy Sĩ, được mua lại từ nhà sưu tầm tư nhân tại Geneva năm 2018."
                                       wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #333;"/>
                                <Label fx:id="lblCertificate" text="Kèm theo giấy chứng nhận xác thực từ Rolex và biên lai mua hàng gốc."
                                       wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #666;"/>
                            </VBox>
                        </VBox>
                    </VBox>

                    <!-- LỊCH SỬ ĐẤU GIÁ -->
                    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #EEEEEE; -fx-border-radius: 12; -fx-padding: 14;" spacing="8">
                        <Label text="Lịch sử đấu giá"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                        <ScrollPane prefHeight="180" fitToWidth="true"
                                    style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                            <content>
                                <VBox fx:id="bidHistory" spacing="6"/>
                            </content>
                        </ScrollPane>
                    </VBox>

                </VBox>

                <!-- CỘT PHẢI -->
                <VBox spacing="12" prefWidth="320">

                    <!-- Tên sản phẩm -->
                    <Label fx:id="lblProductName" text="Đồng Hồ Rolex Submariner Vintage 1960s"
                           wrapText="true" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                    <Label fx:id="lblBidStats" text="48 lượt đấu giá  |  124 người theo dõi"
                           style="-fx-font-size: 12px; -fx-text-fill: #888;"/>

                    <!-- Đồng hồ đếm ngược -->
                    <VBox style="-fx-background-color: #FFF3EB; -fx-background-radius: 12; -fx-padding: 14;" alignment="CENTER" spacing="8">
                        <Label text="Thời gian còn lại"
                               style="-fx-font-size: 11px; -fx-text-fill: #888;" maxWidth="Infinity" alignment="CENTER"/>
                        <HBox alignment="CENTER" spacing="12">
                            <VBox alignment="CENTER">
                                <Label fx:id="lblHours" text="02"
                                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #F97316;"/>
                                <Label text="Giờ" style="-fx-font-size: 10px; -fx-text-fill: #888;"/>
                            </VBox>
                            <Label text=":" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #F97316;"/>
                            <VBox alignment="CENTER">
                                <Label fx:id="lblMinutes" text="14"
                                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #F97316;"/>
                                <Label text="Phút" style="-fx-font-size: 10px; -fx-text-fill: #888;"/>
                            </VBox>
                            <Label text=":" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #F97316;"/>
                            <VBox alignment="CENTER">
                                <Label fx:id="lblSeconds" text="30"
                                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #F97316;"/>
                                <Label text="Giây" style="-fx-font-size: 10px; -fx-text-fill: #888;"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Giá -->
                    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #EEEEEE; -fx-border-radius: 12; -fx-padding: 14;" spacing="4">
                        <Label text="Giá hiện tại" style="-fx-font-size: 11px; -fx-text-fill: #888;"/>
                        <Label fx:id="lblCurrentPrice" text="850.000.000 đ"
                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #F97316;"/>
                        <Label fx:id="lblStartPrice" text="Giá khởi điểm: 500.000.000 đ"
                               style="-fx-font-size: 11px; -fx-text-fill: #888;"/>
                    </VBox>

                    <!-- ĐẶT GIÁ -->
                    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #EEEEEE; -fx-border-radius: 12; -fx-padding: 14;" spacing="8">
                        <Label text="Đặt giá đấu"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                        <TextField fx:id="tfBidAmount" promptText="860.000.000 đ"
                                   style="-fx-background-color: #F5F5F5; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px; -fx-padding: 10 14;"/>
                        <HBox>
                            <Label fx:id="lblMinBid" text="Mức tăng tối thiểu: 10.000.000 đ"
                                   style="-fx-font-size: 11px; -fx-text-fill: #888;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblStep" text="Bước nhảy: 10.000.000 đ"
                                   style="-fx-font-size: 11px; -fx-text-fill: #888;"/>
                        </HBox>

                        <!-- Nút tăng nhanh -->
                        <HBox spacing="6">
                            <Button text="+10.000.000" onAction="#onQuickBid1"
                                    maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                    style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 11px; -fx-cursor: hand; -fx-padding: 6 4;"/>
                            <Button text="+20.000.000" onAction="#onQuickBid2"
                                    maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                    style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 11px; -fx-cursor: hand; -fx-padding: 6 4;"/>
                            <Button text="+50.000.000" onAction="#onQuickBid3"
                                    maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                    style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 11px; -fx-cursor: hand; -fx-padding: 6 4;"/>
                        </HBox>

                        <Button text="Đặt giá ngay" onAction="#onBidNow"
                                maxWidth="Infinity"
                                style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12; -fx-cursor: hand;"/>

                        <!-- Đặt giá tự động -->
                        <VBox style="-fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-background-radius: 8;">
                            <Button fx:id="btnAutoToggle" text="Đặt giá tự động  ▼"
                                    onAction="#onToggleAuto" maxWidth="Infinity"
                                    style="-fx-background-color: #F5F5F5; -fx-text-fill: #444; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 14; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>
                            <VBox fx:id="paneAuto" spacing="8" visible="false" managed="false"
                                  style="-fx-padding: 12 14; -fx-border-color: #E0E0E0; -fx-border-width: 1 0 0 0;">
                                <Label text="Hệ thống tự động tăng giá từng bước khi có người trả cao hơn, chỉ đủ để bạn dẫn đầu, đến mức tối đa bạn đặt."
                                       wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                                <Label text="Giá tối đa sẵn sàng trả"
                                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                                <TextField fx:id="tfMaxPrice" promptText="Ví dụ: 900.000.000 đ"
                                           style="-fx-background-color: #F5F5F5; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px; -fx-padding: 10 14;"/>
                                <Label fx:id="lblAutoStep" text="Bước nhảy tự động: 10.000.000 đ / lần"
                                       style="-fx-font-size: 11px; -fx-text-fill: #888;"/>
                                <Button text="Kích hoạt đặt giá tự động" onAction="#onActivateAuto"
                                        maxWidth="Infinity"
                                        style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10; -fx-cursor: hand;"/>
                            </VBox>
                        </VBox>
                    </VBox>

                    <!-- Người bán -->
                    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #EEEEEE; -fx-border-radius: 12; -fx-padding: 14;" spacing="10">
                        <Label text="Người bán"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label fx:id="lblSellerAvatar" text="LC"
                                   style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 50; -fx-min-width: 36; -fx-min-height: 36; -fx-alignment: CENTER;"/>
                            <VBox>
                                <Label fx:id="lblSellerName" text="Luxury Watch Collector"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                                <Label fx:id="lblSellerStats" text="4.9/5.0  |  156 giao dịch  |  Đã xác minh"
                                       style="-fx-font-size: 11px; -fx-text-fill: #888;"/>
                            </VBox>
                        </HBox>
                    </VBox>

                </VBox>
            </HBox>
        </content>
    </ScrollPane>
</VBox>