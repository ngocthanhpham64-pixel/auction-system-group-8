<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="vn.edu.vnu.uet.group8.client.controller.MainController"
            prefWidth="1280" prefHeight="800"
            style="-fx-background-color: #F8F8F8;">

    <!-- HEADER -->
    <top>
        <HBox style="-fx-background-color: white; -fx-border-color: #F0F0F0; -fx-border-width: 0 0 1 0;"
              alignment="CENTER_LEFT" spacing="14">
            <padding><Insets top="10" bottom="10" left="16" right="16"/></padding>

            <!-- Hamburger toggle -->
            <Button fx:id="btnToggle" text="☰" onAction="#onToggleSidebar"
                    style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 10; -fx-background-radius: 10; -fx-text-fill: #1E3A6E; -fx-font-size: 16px; -fx-padding: 8 12; -fx-cursor: hand;"/>

            <!-- Logo (click về Trang chủ) -->
            <HBox alignment="CENTER_LEFT" spacing="10" onMouseClicked="#onLogoClick" style="-fx-cursor: hand;">
                <ImageView fitWidth="36" fitHeight="36" preserveRatio="true">
                    <image><Image url="@../image/logo.png"/></image>
                </ImageView>
                <VBox>
                    <Label text="AUCTIVA"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1E3A6E;"/>
                    <Label text="LIVE ONLINE AUCTIONS"
                           style="-fx-font-size: 8px; -fx-text-fill: #F97316; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <!-- Search -->
            <TextField fx:id="tfSearch" promptText="Tìm kiếm sản phẩm đấu giá..."
                       maxWidth="280" HBox.hgrow="ALWAYS"
                       style="-fx-background-color: #F5F5F5; -fx-border-color: #EFEFEF; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-size: 12px; -fx-padding: 8 14;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Đấu giá link -->
            <Button fx:id="btnExplore" text="Đấu giá" onAction="#onExploreClick"
                    style="-fx-background-color: transparent; -fx-text-fill: #444; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 14; -fx-cursor: hand;"/>

            <!-- Trực tiếp link -->
            <Button fx:id="btnLive" text="● Trực tiếp" onAction="#onLiveClick"
                    style="-fx-background-color: transparent; -fx-text-fill: #E03030; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 14; -fx-cursor: hand;"/>

            <!-- Divider -->
            <Region prefWidth="1" prefHeight="24" style="-fx-background-color: #E0E0E0;"/>

            <!-- Yêu thích -->
            <StackPane onMouseClicked="#onFavoriteClick" style="-fx-cursor: hand;">
                <Label text="♥" style="-fx-font-size: 20px; -fx-text-fill: #666;"/>
                <Label fx:id="lblFavCount" text="3"
                       style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-font-size: 9px; -fx-font-weight: bold; -fx-background-radius: 50; -fx-padding: 1 4;"
                       StackPane.alignment="TOP_RIGHT"/>
            </StackPane>

            <!-- Thông báo -->
            <StackPane onMouseClicked="#onNotificationClick" style="-fx-cursor: hand;">
                <Label text="🔔" style="-fx-font-size: 18px;"/>
                <Label fx:id="lblNotiCount" text="5"
                       style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-font-size: 9px; -fx-font-weight: bold; -fx-background-radius: 50; -fx-padding: 1 4;"
                       StackPane.alignment="TOP_RIGHT"/>
            </StackPane>

            <!-- Avatar -->
            <Label fx:id="lblAvatar" text="N" onMouseClicked="#onProfileClick"
                   style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 50; -fx-min-width: 32; -fx-min-height: 32; -fx-alignment: CENTER; -fx-cursor: hand;"/>

        </HBox>
    </top>

    <!-- SIDEBAR -->
    <left>
        <VBox fx:id="sidebar" prefWidth="200"
              style="-fx-background-color: white; -fx-border-color: #F0F0F0; -fx-border-width: 0 1 0 0;">
            <padding><Insets top="14" bottom="14" left="12" right="12"/></padding>

            <Button fx:id="btnHome" text="🏠   Trang chủ"
                    userData="HOME" onAction="#onNavClick" maxWidth="Infinity"
                    style="-fx-background-color: #FFF3EB; -fx-text-fill: #F97316; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 14; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-font-size: 12px;"/>
            <Region prefHeight="4"/>
            <Button fx:id="btnMyAuctions" text="📋   Đấu giá của tôi"
                    userData="MY_AUCTIONS" onAction="#onNavClick" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #666; -fx-background-radius: 10; -fx-padding: 10 14; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-font-size: 12px;"/>
            <Region prefHeight="4"/>
            <Button fx:id="btnWallet" text="💰   Ví tiền"
                    userData="WALLET" onAction="#onNavClick" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #666; -fx-background-radius: 10; -fx-padding: 10 14; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-font-size: 12px;"/>

            <Region prefHeight="12"/>
            <Region prefHeight="1" style="-fx-background-color: #F0F0F0;"/>
            <Region prefHeight="12"/>

            <Button fx:id="btnSettings" text="⚙️   Cài đặt"
                    userData="SETTINGS" onAction="#onNavClick" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #666; -fx-background-radius: 10; -fx-padding: 10 14; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-font-size: 12px;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="🚪   Đăng xuất" onAction="#onLogout" maxWidth="Infinity"
                    style="-fx-background-color: #FFF0F0; -fx-text-fill: #E03030; -fx-background-radius: 10; -fx-padding: 10 14; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-font-size: 12px;"/>
        </VBox>
    </left>

    <!-- CONTENT -->
    <center>
        <StackPane fx:id="contentPane" style="-fx-background-color: #F8F8F8;"/>
    </center>

</BorderPane>