<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vn.edu.vnu.uet.group8.client.controller.NotificationController"
      style="-fx-background-color: #F8F8F8;"
      spacing="0">

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
        <content>
            <VBox spacing="20" style="-fx-padding: 24;">

                <!-- TIÊU ĐỀ + NÚT HÀNH ĐỘNG -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="🔔"
                           style="-fx-background-color: #FFF3EB; -fx-background-radius: 50; -fx-font-size: 18px; -fx-min-width: 44; -fx-min-height: 44; -fx-alignment: CENTER;"/>
                    <VBox>
                        <Label text="Thông báo"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                        <Label fx:id="lblNewCount" text="3 thông báo mới"
                               style="-fx-font-size: 12px; -fx-text-fill: #888;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="✓ Đánh dấu đã đọc tất cả" onAction="#onMarkAllRead"
                            style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 12px; -fx-text-fill: #1a1a1a; -fx-cursor: hand; -fx-padding: 7 14;"/>
                    <Button text="🗑 Xóa đã đọc" onAction="#onClearRead"
                            style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 12px; -fx-text-fill: #E03030; -fx-cursor: hand; -fx-padding: 7 14;"/>
                </HBox>

                <!-- TABS -->
                <HBox spacing="8">
                    <Button fx:id="btnTabAll" text="Tất cả (7)" onAction="#onTabAll"
                            style="-fx-background-color: #1a1a1a; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 6 16;"/>
                    <Button fx:id="btnTabUnread" text="Chưa đọc (3)" onAction="#onTabUnread"
                            style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 20; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 6 16;"/>
                    <Button fx:id="btnTabAuction" text="Đấu giá" onAction="#onTabAuction"
                            style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 20; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 6 16;"/>
                    <Button fx:id="btnTabSystem" text="Hệ thống" onAction="#onTabSystem"
                            style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 20; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 6 16;"/>
                </HBox>

                <!-- DANH SÁCH THÔNG BÁO -->
                <VBox fx:id="notificationList" spacing="10">

                    <!-- Bị vượt giá - CHƯA ĐỌC -->
                    <HBox style="-fx-background-color: white; -fx-border-color: #F97316 #EEEEEE #EEEEEE #EEEEEE; -fx-border-width: 1 1 1 3; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 14;"
                          spacing="12" alignment="TOP_LEFT">
                        <Label text="✕"
                               style="-fx-background-color: #FFF0F0; -fx-text-fill: #E03030; -fx-background-radius: 50; -fx-font-size: 14px; -fx-font-weight: bold; -fx-min-width: 40; -fx-min-height: 40; -fx-alignment: CENTER;"/>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="Bạn đã bị vượt giá"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                                <Label text="Mới"
                                       style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-font-size: 10px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 2 8;"/>
                            </HBox>
                            <Label text="Giá của bạn cho &quot;Xe Cổ Mercedes-Benz 1960&quot; đã bị vượt qua"
                                   wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="5 phút trước"
                                       style="-fx-font-size: 11px; -fx-text-fill: #999;"/>
                                <Button text="Đặt giá ngay" onAction="#onBidNow"
                                        style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-font-size: 11px; -fx-background-radius: 6; -fx-padding: 4 12; -fx-cursor: hand;"/>
                            </HBox>
                        </VBox>
                        <Button text="🗑" onAction="#onDeleteNotification"
                                style="-fx-background-color: transparent; -fx-text-fill: #BBB; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 4;"/>
                    </HBox>

                    <!-- Đang dẫn đầu - CHƯA ĐỌC -->
                    <HBox style="-fx-background-color: white; -fx-border-color: #F97316 #EEEEEE #EEEEEE #EEEEEE; -fx-border-width: 1 1 1 3; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 14;"
                          spacing="12" alignment="TOP_LEFT">
                        <Label text="↗"
                               style="-fx-background-color: #F0FFF4; -fx-text-fill: #22C55E; -fx-background-radius: 50; -fx-font-size: 16px; -fx-font-weight: bold; -fx-min-width: 40; -fx-min-height: 40; -fx-alignment: CENTER;"/>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="Bạn đang dẫn đầu"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                                <Label text="Mới"
                                       style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-font-size: 10px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 2 8;"/>
                            </HBox>
                            <Label text="Bạn đang là người đặt giá cao nhất cho &quot;Đồng Hồ Rolex Submariner&quot;"
                                   wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                            <Label text="15 phút trước"
                                   style="-fx-font-size: 11px; -fx-text-fill: #999;"/>
                        </VBox>
                        <Button text="🗑" onAction="#onDeleteNotification"
                                style="-fx-background-color: transparent; -fx-text-fill: #BBB; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 4;"/>
                    </HBox>

                    <!-- Sắp kết thúc - CHƯA ĐỌC -->
                    <HBox style="-fx-background-color: white; -fx-border-color: #F97316 #EEEEEE #EEEEEE #EEEEEE; -fx-border-width: 1 1 1 3; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 14;"
                          spacing="12" alignment="TOP_LEFT">
                        <Label text="⏱"
                               style="-fx-background-color: #FFF3EB; -fx-text-fill: #F97316; -fx-background-radius: 50; -fx-font-size: 16px; -fx-min-width: 40; -fx-min-height: 40; -fx-alignment: CENTER;"/>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="Sắp kết thúc"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                                <Label text="Mới"
                                       style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-font-size: 10px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 2 8;"/>
                            </HBox>
                            <Label text="Phiên đấu giá &quot;Đồng Hồ Patek Philippe&quot; sẽ kết thúc trong 2 giờ"
                                   wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="30 phút trước"
                                       style="-fx-font-size: 11px; -fx-text-fill: #999;"/>
                                <Button text="Đặt giá ngay" onAction="#onBidNow"
                                        style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-font-size: 11px; -fx-background-radius: 6; -fx-padding: 4 12; -fx-cursor: hand;"/>
                            </HBox>
                        </VBox>
                        <Button text="🗑" onAction="#onDeleteNotification"
                                style="-fx-background-color: transparent; -fx-text-fill: #BBB; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 4;"/>
                    </HBox>

                    <!-- Thắng đấu giá - ĐÃ ĐỌC -->
                    <HBox style="-fx-background-color: #FAFAFA; -fx-border-color: #EEEEEE; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 14;"
                          spacing="12" alignment="TOP_LEFT">
                        <Label text="🏆"
                               style="-fx-background-color: #FFF8E1; -fx-background-radius: 50; -fx-font-size: 16px; -fx-min-width: 40; -fx-min-height: 40; -fx-alignment: CENTER;"/>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Chúc mừng! Bạn đã thắng"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                            <Label text="Bạn đã thắng phiên đấu giá &quot;Nhẫn Kim Cương 3 Carat&quot;"
                                   wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="2 giờ trước"
                                       style="-fx-font-size: 11px; -fx-text-fill: #999;"/>
                                <Button text="Xem chi tiết" onAction="#onViewDetail"
                                        style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 11px; -fx-cursor: hand; -fx-padding: 4 12;"/>
                            </HBox>
                        </VBox>
                        <Button text="🗑" onAction="#onDeleteNotification"
                                style="-fx-background-color: transparent; -fx-text-fill: #BBB; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 4;"/>
                    </HBox>

                    <!-- Mặt hàng theo dõi - ĐÃ ĐỌC -->
                    <HBox style="-fx-background-color: #FAFAFA; -fx-border-color: #EEEEEE; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 14;"
                          spacing="12" alignment="TOP_LEFT">
                        <Label text="🔍"
                               style="-fx-background-color: #E8F0FE; -fx-background-radius: 50; -fx-font-size: 16px; -fx-min-width: 40; -fx-min-height: 40; -fx-alignment: CENTER;"/>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Có mặt hàng mới theo dõi của bạn"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                            <Label text="Danh mục Đồng hồ cao cấp — Vừa có sản phẩm mới: Patek Philippe 5711"
                                   wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                            <Label text="1 giờ trước"
                                   style="-fx-font-size: 11px; -fx-text-fill: #999;"/>
                        </VBox>
                        <Button text="🗑" onAction="#onDeleteNotification"
                                style="-fx-background-color: transparent; -fx-text-fill: #BBB; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 4;"/>
                    </HBox>

                </VBox>
            </VBox>
        </content>
    </ScrollPane>
</VBox>