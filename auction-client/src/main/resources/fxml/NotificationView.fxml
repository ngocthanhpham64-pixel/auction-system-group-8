<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vn.edu.vnu.uet.group8.client.controller.NotificationController"
      styleClass="app-bg"
      spacing="0">

    <stylesheets>
        <URL value="@../css/tokens.css"/>
        <URL value="@../css/components.css"/>
        <URL value="@../css/layout.css"/>
    </stylesheets>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scrollpane-clean">
        <content>
            <VBox spacing="20" style="-fx-padding: 24;">

                <!-- TIÊU ĐỀ + NÚT HÀNH ĐỘNG -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="🔔" styleClass="icon-circle-orange" style="-fx-min-width: 44; -fx-min-height: 44; -fx-font-size: 18px;"/>
                    <VBox>
                        <Label text="Thông báo" styleClass="h1"/>
                        <Label fx:id="lblNewCount" text="3 thông báo mới" styleClass="label-info"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="✓ Đánh dấu đã đọc tất cả" onAction="#onMarkAllRead" styleClass="btn-secondary"/>
                    <Button text="🗑 Xóa đã đọc" onAction="#onClearRead" styleClass="btn-secondary text-danger"/>
                </HBox>

                <!-- TABS -->
                <HBox spacing="8">
                    <Button fx:id="btnTabAll" text="Tất cả (7)" onAction="#onTabAll" styleClass="tag-active"/>
                    <Button fx:id="btnTabUnread" text="Chưa đọc (3)" onAction="#onTabUnread" styleClass="tag-inactive"/>
                    <Button fx:id="btnTabAuction" text="Đấu giá" onAction="#onTabAuction" styleClass="tag-inactive"/>
                    <Button fx:id="btnTabSystem" text="Hệ thống" onAction="#onTabSystem" styleClass="tag-inactive"/>
                </HBox>

                <!-- DANH SÁCH THÔNG BÁO -->
                <VBox fx:id="notificationList" spacing="10">

                    <!-- Bị vượt giá - CHƯA ĐỌC -->
                    <HBox styleClass="card-unread" spacing="12" alignment="TOP_LEFT">
                        <Label text="✕" styleClass="icon-circle-danger"/>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="Bạn đã bị vượt giá" styleClass="text-bold" style="-fx-font-size: 13px;"/>
                                <Label text="Mới" styleClass="badge-new"/>
                            </HBox>
                            <Label text="Giá của bạn cho &quot;Xe Cổ Mercedes-Benz 1960&quot; đã bị vượt qua"
                                   wrapText="true" styleClass="label-info"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="5 phút trước" styleClass="text-faint"/>
                                <Button text="Đặt giá ngay" onAction="#onBidNow"
                                        style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-font-size: 11px; -fx-background-radius: 6; -fx-padding: 4 12; -fx-cursor: hand;"/>
                            </HBox>
                        </VBox>
                        <Button text="🗑" onAction="#onDeleteNotification" styleClass="btn-icon"/>
                    </HBox>

                    <!-- Đang dẫn đầu - CHƯA ĐỌC -->
                    <HBox styleClass="card-unread" spacing="12" alignment="TOP_LEFT">
                        <Label text="↗" styleClass="icon-circle-success"/>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="Bạn đang dẫn đầu" styleClass="text-bold" style="-fx-font-size: 13px;"/>
                                <Label text="Mới" styleClass="badge-new"/>
                            </HBox>
                            <Label text="Bạn đang là người đặt giá cao nhất cho &quot;Đồng Hồ Rolex Submariner&quot;"
                                   wrapText="true" styleClass="label-info"/>
                            <Label text="15 phút trước" styleClass="text-faint"/>
                        </VBox>
                        <Button text="🗑" onAction="#onDeleteNotification" styleClass="btn-icon"/>
                    </HBox>

                    <!-- Sắp kết thúc - CHƯA ĐỌC -->
                    <HBox styleClass="card-unread" spacing="12" alignment="TOP_LEFT">
                        <Label text="⏱" styleClass="icon-circle-orange"/>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="Sắp kết thúc" styleClass="text-bold" style="-fx-font-size: 13px;"/>
                                <Label text="Mới" styleClass="badge-new"/>
                            </HBox>
                            <Label text="Phiên đấu giá &quot;Đồng Hồ Patek Philippe&quot; sẽ kết thúc trong 2 giờ"
                                   wrapText="true" styleClass="label-info"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="30 phút trước" styleClass="text-faint"/>
                                <Button text="Đặt giá ngay" onAction="#onBidNow"
                                        style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-font-size: 11px; -fx-background-radius: 6; -fx-padding: 4 12; -fx-cursor: hand;"/>
                            </HBox>
                        </VBox>
                        <Button text="🗑" onAction="#onDeleteNotification" styleClass="btn-icon"/>
                    </HBox>

                    <!-- Thắng đấu giá - ĐÃ ĐỌC -->
                    <HBox styleClass="card-soft" spacing="12" alignment="TOP_LEFT">
                        <Label text="🏆" styleClass="icon-circle-warning"/>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Chúc mừng! Bạn đã thắng" styleClass="text-bold" style="-fx-font-size: 13px;"/>
                            <Label text="Bạn đã thắng phiên đấu giá &quot;Nhẫn Kim Cương 3 Carat&quot;"
                                   wrapText="true" styleClass="label-info"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="2 giờ trước" styleClass="text-faint"/>
                                <Button text="Xem chi tiết" onAction="#onViewDetail"
                                        style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 11px; -fx-cursor: hand; -fx-padding: 4 12;"/>
                            </HBox>
                        </VBox>
                        <Button text="🗑" onAction="#onDeleteNotification" styleClass="btn-icon"/>
                    </HBox>

                    <!-- Mặt hàng theo dõi - ĐÃ ĐỌC -->
                    <HBox styleClass="card-soft" spacing="12" alignment="TOP_LEFT">
                        <Label text="🔍" styleClass="icon-circle-info"/>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Có mặt hàng mới theo dõi của bạn" styleClass="text-bold" style="-fx-font-size: 13px;"/>
                            <Label text="Danh mục Đồng hồ cao cấp — Vừa có sản phẩm mới: Patek Philippe 5711"
                                   wrapText="true" styleClass="label-info"/>
                            <Label text="1 giờ trước" styleClass="text-faint"/>
                        </VBox>
                        <Button text="🗑" onAction="#onDeleteNotification" styleClass="btn-icon"/>
                    </HBox>

                </VBox>
            </VBox>
        </content>
    </ScrollPane>
</VBox>