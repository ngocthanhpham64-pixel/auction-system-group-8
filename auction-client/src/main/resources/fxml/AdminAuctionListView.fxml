<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vn.edu.vnu.uet.group8.client.controller.AdminAuctionListController"
      styleClass="app-background" spacing="16">
    <stylesheets>
        <URL value="@../css/components.css" />
    </stylesheets>
    <padding>
        <Insets top="28" right="28" bottom="24" left="28"/>
    </padding>

    <VBox spacing="4">
        <Label text="Quản lý phiên đấu giá"
               style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #0F172A;"/>
        <Label text="Theo dõi, giám sát và can thiệp kịp thời vào hệ thống giao dịch"
               style="-fx-text-fill: #64748B; -fx-font-size: 13px;"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_LEFT"
          style="-fx-background-color: white; -fx-padding: 12 16;
                 -fx-background-radius: 10; -fx-border-color: #E2E8F0;
                 -fx-border-radius: 10; -fx-border-width: 1;">
        <TextField fx:id="tfSearch"
                   promptText="🔍 Tìm kiếm tên sản phẩm, tài khoản..."
                   HBox.hgrow="ALWAYS"
                   style="-fx-background-radius: 7; -fx-border-color: #CBD5E1;
                          -fx-border-radius: 7; -fx-padding: 8 12; -fx-font-size: 13px;"/>
        <ComboBox fx:id="cbFilterStatus" prefWidth="170" promptText="Lọc trạng thái"
                  styleClass="combo-box"/>
    </HBox>

    <TableView fx:id="auctionTable" VBox.vgrow="ALWAYS"
               style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #E2E8F0;">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn text="ID" fx:id="colId"
                         minWidth="50" prefWidth="60" maxWidth="75"
                         style="-fx-alignment: CENTER; -fx-font-size: 13px;"/>

            <TableColumn text="Tên sản phẩm" fx:id="colTitle"
                         minWidth="220" prefWidth="300"
                         style="-fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 12; -fx-font-size: 13px;"/>

            <TableColumn text="Giá hiện tại" fx:id="colPrice"
                         minWidth="120" prefWidth="140" maxWidth="165"
                         style="-fx-alignment: CENTER-RIGHT; -fx-padding: 0 12 0 0; -fx-font-size: 13px; -fx-font-weight: bold;"/>

            <TableColumn text="Trạng thái" fx:id="colStatus"
                         minWidth="110" prefWidth="125" maxWidth="145"
                         style="-fx-alignment: CENTER; -fx-font-size: 13px;"/>

            <TableColumn text="Thời gian kết thúc" fx:id="colEndTime"
                         minWidth="170" prefWidth="190" maxWidth="210"
                         style="-fx-alignment: CENTER; -fx-font-size: 13px;"/>

            <TableColumn text="Hành động" fx:id="colAction"
                         minWidth="130" prefWidth="145" maxWidth="165"
                         style="-fx-alignment: CENTER;"/>
        </columns>
        <placeholder>
            <Label text="Không có phiên đấu giá nào"
                   style="-fx-text-fill: #94A3B8; -fx-font-size: 13px;"/>
        </placeholder>
    </TableView>

    <HBox spacing="10" alignment="CENTER_LEFT"
          style="-fx-background-color: #F8FAFC; -fx-padding: 12 18;
                 -fx-background-radius: 10; -fx-border-color: #E2E8F0;
                 -fx-border-radius: 10; -fx-border-width: 1;">
        <Label text="Thao tác hàng loạt:"
               style="-fx-text-fill: #475569; -fx-font-weight: 700; -fx-font-size: 12.5px;"/>
        <Region HBox.hgrow="ALWAYS"/>

        <Button text="🚫 Hủy phiên đã chọn" onAction="#cancelSelected"
                style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-weight: bold;
                       -fx-padding: 7 15; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 12.5px;"/>
    </HBox>
</VBox>