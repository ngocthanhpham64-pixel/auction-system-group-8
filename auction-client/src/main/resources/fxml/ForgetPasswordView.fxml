<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<StackPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="vn.edu.vnu.uet.group8.client.controller.ForgetPasswordController"
           styleClass="login-root">

    <stylesheets>
        <URL value="@../css/tokens.css"/>
        <URL value="@../css/components.css"/>
        <URL value="@../css/layout.css"/>
        <URL value="@../css/login.css"/>
    </stylesheets>

    <VBox alignment="CENTER" spacing="0">
        <VBox styleClass="card" maxWidth="360" spacing="0"
              style="-fx-background-radius: 16; -fx-border-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 24, 0, 0, 4);">
            <padding>
                <Insets top="40" bottom="40" left="36" right="36"/>
            </padding>
            <children>

                <HBox alignment="CENTER" spacing="10" style="-fx-padding: 0 0 20 0;">
                    <children>
                        <ImageView fitWidth="60" fitHeight="60" preserveRatio="true">
                            <image>
                                <Image url="@../image/logo.png"/>
                            </image>
                        </ImageView>
                        <VBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="AUCTIVA" styleClass="logo-title-lg"/>
                                <Label text="LIVE ONLINE AUCTIONS" styleClass="logo-subtitle-muted"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <Label text="Khôi phục mật khẩu" maxWidth="Infinity" alignment="CENTER" styleClass="h1"/>
                <Label text="Nhập Email nhận mã xác thực và thiết lập lại mật khẩu" 
                       maxWidth="Infinity" alignment="CENTER" styleClass="text-muted" 
                       style="-fx-padding: 4 0 20 0;" textAlignment="CENTER" wrapText="true"/>

                <VBox spacing="12" style="-fx-padding: 10 0 0 0;">
                    <children>
                        
                        <VBox fx:id="vboxEmailStep" spacing="12">
                            <children>
                                <VBox spacing="4">
                                    <children>
                                        <Label text="Email tài khoản" styleClass="form-label"/>
                                        <TextField fx:id="tfEmail" promptText="example@email.com" styleClass="form-input"/>
                                    </children>
                                </VBox>
                                <Button fx:id="btnSendOtp" onAction="#onSendOtp" text="GỬI MÃ XÁC THỰC" maxWidth="Infinity"
                                        style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 10;"/>
                            </children>
                        </VBox>

                        <VBox fx:id="vboxResetStep" spacing="12" visible="false" managed="false">
                            <children>
                                <VBox spacing="4">
                                    <children>
                                        <Label text="Mã xác thực OTP" styleClass="form-label"/>
                                        <TextField fx:id="tfOtp" promptText="Mã 6 số" styleClass="form-input"/>
                                    </children>
                                </VBox>

                                <VBox spacing="4">
                                    <children>
                                        <Label text="Mật khẩu mới" styleClass="form-label"/>
                                        <PasswordField fx:id="pfNewPassword" promptText="Tối thiểu 6 ký tự" styleClass="form-input"/>
                                    </children>
                                </VBox>

                                <VBox spacing="4">
                                    <children>
                                        <Label text="Xác nhận mật khẩu mới" styleClass="form-label"/>
                                        <PasswordField fx:id="pfConfirmPassword" promptText="Nhập lại mật khẩu mới" styleClass="form-input"/>
                                    </children>
                                </VBox>

                                <Button fx:id="btnResetPassword" onAction="#onResetPassword" text="Xác nhận đổi mật khẩu" maxWidth="Infinity"
                                        style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 12 0;"/>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <Label fx:id="lblStatus" maxWidth="Infinity" alignment="CENTER"
                       styleClass="text-danger" style="-fx-font-size: 12px; -fx-padding: 14 0 0 0;"
                       visible="false"/>

                <HBox alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                    <children>
                        <Label fx:id="lblBackToLogin" onMouseClicked="#onBackToLogin" text="← Quay lại đăng nhập" 
                               styleClass="text-link" style="-fx-font-weight: bold; -fx-cursor: hand;"/>
                    </children>
                </HBox>

            </children>
        </VBox>
    </VBox>
</StackPane>