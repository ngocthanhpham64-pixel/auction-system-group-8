<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox fx:id="rowRoot" alignment="CENTER_LEFT" spacing="15.0" styleClass="glass-card" style="-fx-padding: 12px; -fx-cursor: hand;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.edu.vnu.uet.group8.client.controller.GenericListItemController">
   <children>
      <StackPane fx:id="iconContainer" minHeight="45.0" minWidth="45.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 10px;">
         <children>
            <Label fx:id="lblIcon" style="-fx-font-size: 18px;" text="🔔" />
         </children>
      </StackPane>

      <VBox spacing="2.0" HBox.hgrow="ALWAYS">
         <children>
            <Label fx:id="lblTitle" styleClass="text-heading" style="-fx-font-weight: bold; -fx-font-size: 13px;" text="Tiêu đề chính" />
            <Label fx:id="lblSubtitle" styleClass="text-sub" style="-fx-font-size: 11px;" text="Mô tả phụ hoặc thời gian" />
         </children>
      </VBox>

      <Region HBox.hgrow="NEVER" minWidth="10.0" />

      <Label fx:id="lblValue" alignment="CENTER_RIGHT" styleClass="text-heading" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Giá trị" />
   </children>
</HBox>