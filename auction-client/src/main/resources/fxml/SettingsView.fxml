<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<VBox minWidth="1050.0" spacing="20.0" style="-fx-background-color: transparent;" 
      xmlns="http://javafx.com/javafx/26" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="vn.edu.vnu.uet.group8.client.controller.SettingsController">
    <children>
        
        <HBox alignment="BOTTOM_LEFT">
            <children>
                <Label styleClass="text-heading" text="Cài đặt hệ thống">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>
            </children>
        </HBox>
        
        <VBox styleClass="glass-card" style="-fx-background-radius: 16px; -fx-border-radius: 16px; -fx-border-width: 1.5px;">
            <children>
                
                <HBox alignment="CENTER_LEFT" style="-fx-padding: 24 24 24 24; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1px 0;" styleClass="settings-row">
                    <children>
                        <VBox spacing="4.0">
                            <children>
                                <Label styleClass="text-heading" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Giao diện hiển thị" />
                                <Label styleClass="text-sub" style="-fx-font-size: 13px;" text="Thay đổi màu sắc giao diện phù hợp với môi trường làm việc của bạn." />
                            </children>
                        </VBox>
                        
                        <Region HBox.hgrow="ALWAYS" />
                        
                        <HBox alignment="CENTER" style="-fx-background-color: rgba(0, 0, 0, 0.05); -fx-background-radius: 30px; -fx-padding: 4px;" styleClass="toggle-container">
                            <children>
                                <Button fx:id="btnLightMode" mnemonicParsing="false" onAction="#onLightModeClick" 
                                        style="-fx-background-radius: 20px; -fx-padding: 8px 16px; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" 
                                        styleClass="toggle-btn-active" text="☀️ Sáng" />
                                        
                                <Button fx:id="btnDarkMode" mnemonicParsing="false" onAction="#onDarkModeClick" 
                                        style="-fx-background-radius: 20px; -fx-padding: 8px 16px; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" 
                                        styleClass="toggle-btn-inactive" text="🌙 Tối" />
                            </children>
                        </HBox>
                    </children>
                </HBox>
                
                <HBox alignment="CENTER_LEFT" style="-fx-padding: 24 24 24 24;">
                    <children>
                        <VBox spacing="4.0">
                            <children>
                                <Label styleClass="text-heading" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-opacity: 0.5;" text="Ngôn ngữ hệ thống (Language)" />
                                <Label styleClass="text-sub" style="-fx-font-size: 13px; -fx-opacity: 0.5;" text="Tính năng đang được phát triển ở phiên bản tiếp theo." />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" style="-fx-background-color: rgba(0, 0, 0, 0.03); -fx-background-radius: 30px; -fx-padding: 4px; -fx-opacity: 0.5;">
                            <children>
                                <Button disable="true" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-padding: 8px 16px; -fx-font-size: 13px;" text="Tiếng Việt" />
                                <Button disable="true" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-padding: 8px 16px; -fx-font-size: 13px;" text="English" />
                            </children>
                        </HBox>
                    </children>
                </HBox>
                
            </children>
            <effect>
                <DropShadow blurType="GAUSSIAN" offsetY="5.0" radius="15.0">
                    <color>
                        <Color opacity="0.06" />
                    </color>
                </DropShadow>
            </effect>
        </VBox>
    </children>
</VBox>