<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="440.0" spacing="18.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.edu.vnu.uet.group8.client.controller.ChangePasswordController">
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   <children>
      
      <VBox spacing="6.0">
         <children>
            <Label style="-fx-text-fill: #475569; -fx-font-weight: bold; -fx-font-size: 12px;" text="MẬT KHẨU HIỆN TẠI" />
            <PasswordField fx:id="pfOldPassword" prefHeight="40.0" promptText="Nhập mật khẩu cũ của tài khoản" styleClass="form-input" style="-fx-font-size: 14px;" />
         </children>
      </VBox>

      <VBox spacing="6.0">
         <children>
            <Label style="-fx-text-fill: #475569; -fx-font-weight: bold; -fx-font-size: 12px;" text="MẬT KHẨU MỚI" />
            <PasswordField fx:id="pfNewPassword" prefHeight="40.0" promptText="Tối thiểu 6 ký tự bảo mật" styleClass="form-input" style="-fx-font-size: 14px;" />
         </children>
      </VBox>

      <VBox spacing="6.0">
         <children>
            <Label style="-fx-text-fill: #475569; -fx-font-weight: bold; -fx-font-size: 12px;" text="XÁC NHẬN MẬT KHẨU MỚI" />
            <PasswordField fx:id="pfConfirmPassword" prefHeight="40.0" promptText="Nhập lại chính xác mật khẩu mới" styleClass="form-input" style="-fx-font-size: 14px;" />
         </children>
      </VBox>

      <Button fx:id="btnConfirmChangePassword" maxWidth="1.7976931348623157E308" prefHeight="45.0" style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10px; -fx-font-size: 14px; -fx-cursor: hand;" text="CẬP NHẬT MẬT KHẨU" />
      
   </children>
</VBox>