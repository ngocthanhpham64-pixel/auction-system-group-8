<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vn.edu.vnu.uet.group8.client.controller.AdminUserListController"
      spacing="16" styleClass="app-background">
    <stylesheets>
        <URL value="@../css/components.css" />
    </stylesheets>
    <padding>
        <Insets top="28" right="28" bottom="24" left="28"/>
    </padding>

    <VBox spacing="4">
        <Label text="Quản lý người dùng"
               style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #0F172A;"/>
        <Label text="Quản lý tài khoản, vai trò và trạng thái người dùng trong hệ thống"
               style="-fx-text-fill: #64748B; -fx-font-size: 13px;"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_LEFT"
          style="-fx-background-color: white; -fx-padding: 12 16;
                 -fx-background-radius: 10; -fx-border-color: #E2E8F0;
                 -fx-border-radius: 10; -fx-border-width: 1;">
        <TextField fx:id="tfSearch" promptText="🔍 Tìm kiếm theo tài khoản, email..."
                   prefWidth="320"
                   style="-fx-background-radius: 6; -fx-padding: 8 12; -fx-font-size: 13px;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="cbFilterRole" prefWidth="130"
                  style="-fx-background-radius: 6; -fx-padding: 4; -fx-font-size: 13px;"/>
        <ComboBox fx:id="cbFilterStatus" prefWidth="140"
                  style="-fx-background-radius: 6; -fx-padding: 4; -fx-font-size: 13px;"/>
    </HBox>

    <TableView fx:id="userTable" VBox.vgrow="ALWAYS"
               style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #E2E8F0;">
        <columns>
            <TableColumn text="ID" fx:id="colId"
                         minWidth="50" prefWidth="60" maxWidth="80"
                         style="-fx-alignment: CENTER; -fx-font-size: 13px;"/>
            <TableColumn text="Tên đăng nhập" fx:id="colUsername"
                         minWidth="120" prefWidth="150" maxWidth="180"
                         style="-fx-alignment: CENTER; -fx-font-size: 13px;"/>
            <TableColumn text="Email" fx:id="colEmail"
                         minWidth="180" prefWidth="250" maxWidth="350"
                         style="-fx-alignment: CENTER; -fx-font-size: 13px;"/>
            <TableColumn text="Vai trò" fx:id="colRole"
                         minWidth="100" prefWidth="120" maxWidth="140"
                         style="-fx-alignment: CENTER; -fx-font-size: 13px;"/>
            <TableColumn text="Trạng thái" fx:id="colStatus"
                         minWidth="110" prefWidth="130" maxWidth="150"
                         style="-fx-alignment: CENTER; -fx-font-size: 13px;"/>
            <TableColumn text="Hành động" fx:id="colAction"
                         minWidth="140" prefWidth="150" maxWidth="180"
                         style="-fx-alignment: CENTER;"/>
        </columns>
        <placeholder>
            <Label text="Không tìm thấy người dùng phù hợp"
                   style="-fx-text-fill: #94A3B8; -fx-font-size: 13px;"/>
        </placeholder>
    </TableView>

    <HBox spacing="10" alignment="CENTER_LEFT"
          style="-fx-background-color: #F8FAFC; -fx-padding: 12 18;
                 -fx-background-radius: 10; -fx-border-color: #E2E8F0;
                 -fx-border-radius: 10; -fx-border-width: 1;">
        <Label text="Thao tác nhanh trên dòng chọn:"
               style="-fx-text-fill: #475569; -fx-font-weight: 700; -fx-font-size: 12.5px;"/>
        <Region HBox.hgrow="ALWAYS"/>

        <Button text="🔒 Khóa tạm thời" onAction="#suspendSelected"
                style="-fx-background-color: #F59E0B; -fx-text-fill: white; -fx-font-weight: bold;
                       -fx-padding: 6 12; -fx-background-radius: 6; -fx-cursor: hand;"/>
        <Button text="🚫 Cấm vĩnh viễn" onAction="#banSelected"
                style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-weight: bold;
                       -fx-padding: 6 12; -fx-background-radius: 6; -fx-cursor: hand;"/>
        <Button text="🔓 Kích hoạt lại" onAction="#restoreSelected"
                style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold;
                       -fx-padding: 6 12; -fx-background-radius: 6; -fx-cursor: hand;"/>
    </HBox>
</VBox>