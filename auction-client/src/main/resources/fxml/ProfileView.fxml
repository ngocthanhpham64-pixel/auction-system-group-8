<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vn.edu.vnu.uet.group8.client.controller.ProfileController"
      styleClass="app-bg"
      spacing="0">

    <stylesheets>
        <URL value="@../css/tokens.css"/>
        <URL value="@../css/components.css"/>
        <URL value="@../css/layout.css"/>
    </stylesheets>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scrollpane-clean">
        <content>
            <VBox spacing="16" style="-fx-padding: 24;">

                <!-- HEADER CAM -->
                <HBox styleClass="card-orange" alignment="CENTER_LEFT" spacing="20">

                    <Label fx:id="lblAvatar" text="N" styleClass="avatar-lg"/>

                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label fx:id="lblName" text="Nguyễn Văn A"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label fx:id="lblEmail" text="nguyenvana@email.com"
                               style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.8);"/>
                        <Label fx:id="lblJoinDate" text="Tham gia tháng 3/2024"
                               style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.6);"/>
                    </VBox>

                    <HBox spacing="8">
                        <Button text="Cài đặt" onAction="#onSettings"
                                style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.4); -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 7 14;"/>
                        <Button text="Đăng xuất" onAction="#onLogout"
                                style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.4); -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 7 14;"/>
                    </HBox>
                </HBox>

                <!-- THỐNG KÊ -->
                <HBox spacing="12">
                    <VBox styleClass="card" style="-fx-padding: 16;" alignment="CENTER" HBox.hgrow="ALWAYS">
                        <Label text="Tổng lượt đấu giá" styleClass="text-muted" style="-fx-padding: 0 0 6 0;"/>
                        <Label fx:id="lblTotalBids" text="234"
                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                    </VBox>
                    <VBox styleClass="card" style="-fx-padding: 16;" alignment="CENTER" HBox.hgrow="ALWAYS">
                        <Label text="Đấu giá thành công" styleClass="text-muted" style="-fx-padding: 0 0 6 0;"/>
                        <Label fx:id="lblWonBids" text="45"
                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #22C55E;"/>
                    </VBox>
                    <VBox styleClass="card" style="-fx-padding: 16;" alignment="CENTER" HBox.hgrow="ALWAYS">
                        <Label text="Đang tham gia" styleClass="text-muted" style="-fx-padding: 0 0 6 0;"/>
                        <Label fx:id="lblActiveBids" text="12"
                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #F97316;"/>
                    </VBox>
                    <VBox styleClass="card" style="-fx-padding: 16;" alignment="CENTER" HBox.hgrow="ALWAYS">
                        <Label text="Đánh giá trung bình" styleClass="text-muted" style="-fx-padding: 0 0 6 0;"/>
                        <Label fx:id="lblRating" text="4.8"
                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                    </VBox>
                </HBox>

                <!-- SỐ DƯ TÀI KHOẢN -->
                <HBox styleClass="card" style="-fx-padding: 16;" alignment="CENTER_LEFT">
                    <VBox>
                        <Label text="Số dư tài khoản" styleClass="label-info" style="-fx-padding: 0 0 4 0;"/>
                        <Label fx:id="lblBalance" text="50.000.000 đ"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Nạp tiền" onAction="#onDeposit" styleClass="btn-primary"/>
                </HBox>

                <!-- LỊCH SỬ ĐẤU GIÁ -->
                <VBox styleClass="card" style="-fx-padding: 16;" spacing="14">

                    <HBox spacing="8">
                        <Button fx:id="btnTabActive" text="Đang tham gia" onAction="#onTabActive" styleClass="tag-active"/>
                        <Button fx:id="btnTabWon" text="Đã thắng" onAction="#onTabWon" styleClass="tag-inactive"/>
                        <Button fx:id="btnTabLost" text="Đã thua" onAction="#onTabLost" styleClass="tag-inactive"/>
                    </HBox>

                    <VBox fx:id="bidHistoryList" spacing="10"/>

                </VBox>

            </VBox>
        </content>
    </ScrollPane>
</VBox>