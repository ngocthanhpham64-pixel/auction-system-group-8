<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vn.edu.vnu.uet.group8.client.controller.FavoriteController"
      styleClass="app-bg"
      spacing="0">

    <stylesheets>
        <URL value="@../css/tokens.css"/>
        <URL value="@../css/components.css"/>
        <URL value="@../css/layout.css"/>
    </stylesheets>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scrollpane-clean">
        <content>
            <VBox spacing="14" style="-fx-padding: 24;">

                <!-- TIÊU ĐỀ + NÚT XÓA -->
                <HBox alignment="TOP_LEFT">
                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Danh sách yêu thích" styleClass="h2"/>
                        <Label fx:id="lblActiveCount" text="Bạn có 8 món đang còn thời gian đấu giá"
                               styleClass="label-info" style="-fx-padding: 4 0 0 0;"/>
                    </VBox>
                    <Button text="Xóa đã kết thúc" onAction="#onClearEnded" styleClass="btn-secondary text-danger"/>
                </HBox>

                <!-- TABS -->
                <HBox spacing="8">
                    <Button fx:id="btnTabAll" text="Tất cả (12)" onAction="#onTabAll" styleClass="tag-active"/>
                    <Button fx:id="btnTabActive" text="Đang hoạt động (8)" onAction="#onTabActive" styleClass="tag-inactive"/>
                    <Button fx:id="btnTabEnded" text="Đã kết thúc (4)" onAction="#onTabEnded" styleClass="tag-inactive"/>
                </HBox>

                <!-- DANH SÁCH MÓN YÊU THÍCH -->
                <FlowPane fx:id="favoriteContainer" hgap="14" vgap="14"
                          style="-fx-background-color: transparent;"/>

            </VBox>
        </content>
    </ScrollPane>
</VBox>