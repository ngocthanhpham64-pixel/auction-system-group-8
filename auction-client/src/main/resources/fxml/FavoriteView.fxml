<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vn.edu.vnu.uet.group8.client.controller.FavoriteController"
      style="-fx-background-color: #F8F8F8;"
      spacing="0">

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
        <content>
            <VBox spacing="14" style="-fx-padding: 24;">

                <!-- TIÊU ĐỀ + NÚT XÓA -->
                <HBox alignment="TOP_LEFT">
                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Danh sách yêu thích"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                        <Label fx:id="lblActiveCount" text="Bạn có 8 món đang còn thời gian đấu giá"
                               style="-fx-font-size: 12px; -fx-text-fill: #888; -fx-padding: 4 0 0 0;"/>
                    </VBox>
                    <Button text="Xóa đã kết thúc" onAction="#onClearEnded"
                            style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 12px; -fx-text-fill: #E03030; -fx-cursor: hand; -fx-padding: 7 14;"/>
                </HBox>

                <!-- TABS -->
                <HBox spacing="8">
                    <Button fx:id="btnTabAll" text="Tất cả (12)" onAction="#onTabAll"
                            style="-fx-background-color: #1a1a1a; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 6 16;"/>
                    <Button fx:id="btnTabActive" text="Đang hoạt động (8)" onAction="#onTabActive"
                            style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 20; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 6 16;"/>
                    <Button fx:id="btnTabEnded" text="Đã kết thúc (4)" onAction="#onTabEnded"
                            style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 20; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 6 16;"/>
                </HBox>

                <!-- DANH SÁCH MÓN YÊU THÍCH -->
                <FlowPane fx:id="favoriteContainer"
                          hgap="14" vgap="14"
                          style="-fx-background-color: transparent;"/>

            </VBox>
        </content>
    </ScrollPane>
</VBox>