<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<!--
    ExploreView.fxml — UPGRADED
    - TilePane thêm prefColumns="4" + maxWidth=MAX → số cột tự điều chỉnh
    - Không cần ScrollPane riêng (dùng của MainLayout)
    - prefTileWidth="240" → mỗi card rộng 240px
    - prefTileHeight="340" → chiều cao card đồng đều
-->
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vn.edu.vnu.uet.group8.client.controller.ExploreController"
      maxWidth="1.7976931348623157E308"
      style="-fx-background-color: transparent;"
      spacing="0">

    <stylesheets>
        <URL value="@../css/tokens.css"/>
        <URL value="@../css/components.css"/>
        <URL value="@../css/layout.css"/>
    </stylesheets>

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 16 0 14 0;">
        <VBox spacing="4">
            <Label text="Sàn đấu giá / Khám phá"
                   style="-fx-text-fill: #9ca3af; -fx-font-size: 12px;"/>
            <Label text="Tất cả phiên đấu giá"
                   styleClass="text-heading" style="-fx-font-size: 22px; -fx-font-weight: 900;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblResultCount" text=""
               style="-fx-text-fill: #6b7280; -fx-font-weight: bold; -fx-font-size: 13px;"/>
    </HBox>

    <!-- FILTERS -->
    <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 0 0 20 0;">
        <ScrollPane fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="NEVER" 
                    style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" 
                    HBox.hgrow="ALWAYS">
            <content>
                <HBox fx:id="hboxTags" alignment="CENTER_LEFT" spacing="8" style="-fx-background-color: transparent;">
                    <Button fx:id="btnTagAll" text="Tất cả" onAction="#onTagClick" userData="ALL" styleClass="tag-pill-active"/>
                    <Button fx:id="btnTagWatches" text="⌚ Đồng hồ" onAction="#onTagClick" userData="WATCHES" styleClass="tag-pill"/>
                    <Button fx:id="btnTagElectronics" text="💻 Điện tử" onAction="#onTagClick" userData="ELECTRONICS" styleClass="tag-pill"/>
                    <Button fx:id="btnTagJewelry" text="💎 Trang sức" onAction="#onTagClick" userData="JEWELRY" styleClass="tag-pill"/>
                </HBox>
            </content>
        </ScrollPane>
        <ComboBox fx:id="cbSort" promptText="Sắp xếp: Mới nhất"
                  prefWidth="170" styleClass="form-input-sm form-input"/>
        <ComboBox fx:id="cbCategory" promptText="Danh mục"
                  prefWidth="160" styleClass="form-input-sm form-input"/>
    </HBox>

    <!--
        TILE PANE — product cards
        prefTileWidth / prefTileHeight : kích thước mỗi card
        maxWidth=MAX : cho phép TilePane fill hết width
    -->
    <TilePane
        fx:id="productContainer"
        hgap="20"
        vgap="24"
        prefTileWidth="240"
        prefTileHeight="340"
        alignment="TOP_LEFT"
        maxWidth="1.7976931348623157E308"
        style="-fx-padding: 8 0 24 0; -fx-background-color: transparent;">
        <!-- ProductCard nodes sẽ được render ở đây bởi ExploreController -->
    </TilePane>

    <!-- PAGINATION BAR -->
    <HBox alignment="CENTER" spacing="12" style="-fx-padding: 16 0 48 0;">
        <Button fx:id="btnPrevPage" text="← Trang trước"
                onAction="#onPrevPage"
                styleClass="tag-pill"
                style="-fx-padding: 8 20 8 20;"/>
        <HBox alignment="CENTER" spacing="6">
            <Label text="Trang" style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;"/>
            <Label fx:id="lblCurrentPage" text="1"
                   style="-fx-text-fill: #f97316; -fx-font-weight: bold; -fx-font-size: 15px;"/>
            <Label text="/" style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;"/>
            <Label fx:id="lblTotalPages" text="1"
                   style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;"/>
        </HBox>
        <Button fx:id="btnNextPage" text="Trang sau →"
                onAction="#onNextPage"
                styleClass="tag-pill"
                style="-fx-padding: 8 20 8 20;"/>
    </HBox>

</VBox>
