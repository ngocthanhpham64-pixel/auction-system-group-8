<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vn.edu.vnu.uet.group8.client.controller.SellerDashboardController"
      styleClass="app-bg-light"
      spacing="0" prefWidth="1200" prefHeight="800">

    <stylesheets>
        <URL value="@../css/tokens.css"/>
        <URL value="@../css/components.css"/>
        <URL value="@../css/layout.css"/>
    </stylesheets>

    <padding><Insets top="24" bottom="24" left="32" right="32"/></padding>

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Quản lý sản phẩm" styleClass="h1"/>
            <Label text="Đăng bán + theo dõi sản phẩm của bạn" styleClass="label-info"/>
        </VBox>
        <Button text="+ Đăng sản phẩm mới"
                onAction="#onCreateNew"
                styleClass="btn-primary"
                prefHeight="42"
                style="-fx-padding: 10 18;"/>
    </HBox>

    <!-- THỐNG KÊ -->
    <HBox spacing="16" style="-fx-padding: 20 0 20 0;">
        <VBox styleClass="card" HBox.hgrow="ALWAYS" prefHeight="80"
              style="-fx-background-radius: 12; -fx-padding: 16;">
            <Label text="Đang bán" styleClass="label-info"/>
            <Label fx:id="lblListedCount" text="0" styleClass="h2"
                   style="-fx-text-fill: #F97316;"/>
        </VBox>
        <VBox styleClass="card" HBox.hgrow="ALWAYS" prefHeight="80"
              style="-fx-background-radius: 12; -fx-padding: 16;">
            <Label text="Đã bán" styleClass="label-info"/>
            <Label fx:id="lblSoldCount" text="0" styleClass="h2"
                   style="-fx-text-fill: #22C55E;"/>
        </VBox>
        <VBox styleClass="card" HBox.hgrow="ALWAYS" prefHeight="80"
              style="-fx-background-radius: 12; -fx-padding: 16;">
            <Label text="Tổng doanh thu" styleClass="label-info"/>
            <Label fx:id="lblTotalRevenue" text="0 đ" styleClass="h2"
                   style="-fx-text-fill: #1E3A6E;"/>
        </VBox>
        <VBox styleClass="card" HBox.hgrow="ALWAYS" prefHeight="80"
              style="-fx-background-radius: 12; -fx-padding: 16;">
            <Label text="Đánh giá" styleClass="label-info"/>
            <Label fx:id="lblRating" text="--" styleClass="h2"
                   style="-fx-text-fill: #F97316;"/>
        </VBox>
    </HBox>

    <!-- TABS -->
    <HBox spacing="8" style="-fx-padding: 0 0 16 0;">
        <Button fx:id="btnTabAll" text="Tất cả"
                onAction="#onTabAll" styleClass="tag-active"/>
        <Button fx:id="btnTabDraft" text="Bản nháp"
                onAction="#onTabDraft" styleClass="tag-inactive"/>
        <Button fx:id="btnTabListed" text="Đang bán"
                onAction="#onTabListed" styleClass="tag-inactive"/>
        <Button fx:id="btnTabSold" text="Đã bán"
                onAction="#onTabSold" styleClass="tag-inactive"/>
    </HBox>

    <!-- DANH SÁCH SẢN PHẨM -->
    <ScrollPane fitToWidth="true" styleClass="scrollpane-clean" VBox.vgrow="ALWAYS">
        <VBox fx:id="itemListContainer" spacing="12">
            <!-- Items load động bởi controller -->
        </VBox>
    </ScrollPane>

    <Label fx:id="lblEmpty" text="Bạn chưa đăng sản phẩm nào"
           styleClass="label-info"
           visible="false" managed="false"
           style="-fx-padding: 40 0; -fx-alignment: center;"/>
</VBox>