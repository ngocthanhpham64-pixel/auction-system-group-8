<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.hellofx.HelloController"
      style="-fx-background-color: #F8F8F8;"
      spacing="0">

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
        <content>
            <VBox spacing="20" style="-fx-padding: 24;">

                <!-- HERO BANNER -->
                <VBox style="-fx-background-color: #F97316; -fx-background-radius: 16; -fx-padding: 28;" spacing="8">
                    <Label text="CHÀO MỪNG ĐẾN VỚI AUCTIVA"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: rgba(255,255,255,0.9);"/>
                    <Label text="Đấu giá trực tuyến minh bạch"
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Khám phá hàng nghìn phiên đấu giá độc đáo từ đồng hồ cổ điển đến nghệ thuật quý hiếm"
                           wrapText="true"
                           style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.9);"/>
                    <HBox style="-fx-padding: 8 0 0 0;">
                        <Button text="Khám phá ngay →" onAction="#onExploreNow"
                                style="-fx-background-color: white; -fx-text-fill: #F97316; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 24; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <!-- THỐNG KÊ -->
                <HBox spacing="12">
                    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #EEEEEE; -fx-border-radius: 12; -fx-padding: 14;" alignment="CENTER" HBox.hgrow="ALWAYS">
                        <Label text="Phiên đang diễn ra"
                               style="-fx-font-size: 11px; -fx-text-fill: #888; -fx-padding: 0 0 4 0;"/>
                        <Label fx:id="lblActiveAuctions" text="128"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #F97316;"/>
                    </VBox>
                    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #EEEEEE; -fx-border-radius: 12; -fx-padding: 14;" alignment="CENTER" HBox.hgrow="ALWAYS">
                        <Label text="Người tham gia"
                               style="-fx-font-size: 11px; -fx-text-fill: #888; -fx-padding: 0 0 4 0;"/>
                        <Label fx:id="lblParticipants" text="2,547"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                    </VBox>
                    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #EEEEEE; -fx-border-radius: 12; -fx-padding: 14;" alignment="CENTER" HBox.hgrow="ALWAYS">
                        <Label text="Đã giao dịch"
                               style="-fx-font-size: 11px; -fx-text-fill: #888; -fx-padding: 0 0 4 0;"/>
                        <Label fx:id="lblTotalTraded" text="15.2 tỷ"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #22C55E;"/>
                    </VBox>
                    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #EEEEEE; -fx-border-radius: 12; -fx-padding: 14;" alignment="CENTER" HBox.hgrow="ALWAYS">
                        <Label text="Sản phẩm"
                               style="-fx-font-size: 11px; -fx-text-fill: #888; -fx-padding: 0 0 4 0;"/>
                        <Label fx:id="lblTotalProducts" text="3,891"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                    </VBox>
                </HBox>

                <!-- DANH MỤC -->
                <VBox spacing="10">
                    <Label text="Danh mục nổi bật"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                    <HBox spacing="8">
                        <Button text="Tất cả" onAction="#onCategoryAll"
                                style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 16;"/>
                        <Button text="Đồ điện tử" onAction="#onCategoryElectronics"
                                style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 20; -fx-background-radius: 20; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 8 16;"/>
                        <Button text="Thời trang" onAction="#onCategoryFashion"
                                style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 20; -fx-background-radius: 20; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 8 16;"/>
                        <Button text="Đồ cổ" onAction="#onCategoryAntiques"
                                style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 20; -fx-background-radius: 20; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 8 16;"/>
                        <Button text="Bất động sản" onAction="#onCategoryRealEstate"
                                style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 20; -fx-background-radius: 20; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 8 16;"/>
                        <Button text="Xe cộ" onAction="#onCategoryVehicles"
                                style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 20; -fx-background-radius: 20; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 8 16;"/>
                        <Button text="Khác" onAction="#onCategoryOther"
                                style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 20; -fx-background-radius: 20; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 8 16;"/>
                    </HBox>
                </VBox>

                <!-- ĐẤU GIÁ NỔI BẬT -->
                <HBox alignment="CENTER_LEFT">
                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="🔥 Đấu giá nổi bật"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                        <Label text="Những phiên đấu giá hot nhất hôm nay"
                               style="-fx-font-size: 11px; -fx-text-fill: #888; -fx-padding: 2 0 0 0;"/>
                    </VBox>
                    <Label text="Xem tất cả →" onMouseClicked="#onViewAllAuctions"
                           style="-fx-font-size: 12px; -fx-text-fill: #F97316; -fx-cursor: hand; -fx-font-weight: bold;"/>
                </HBox>

                <!-- DANH SÁCH SẢN PHẨM -->
                <FlowPane fx:id="productContainer"
                          hgap="16" vgap="16"
                          style="-fx-background-color: transparent;"/>

            </VBox>
        </content>
    </ScrollPane>
</VBox>