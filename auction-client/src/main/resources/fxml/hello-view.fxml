<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="768.0" prefWidth="1024.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.edu.vnu.uet.group8.client.controller.HelloController">

   <left>
      <VBox prefWidth="250.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="sidebar-title" text="AuctionPro">
               <VBox.margin><Insets bottom="30.0" /></VBox.margin>
            </Label>

            <Label style="-fx-text-fill: #666; -fx-font-size: 12px;" text="CHÍNH">
               <VBox.margin><Insets bottom="10.0" /></VBox.margin>
            </Label>
            <Button maxWidth="Infinity" styleClass="sidebar-btn, sidebar-btn-active" text="🏦 Tổng quan" />
            <Button maxWidth="Infinity" styleClass="sidebar-btn" text="🔥 Đang đấu giá" />
            <Button maxWidth="Infinity" styleClass="sidebar-btn" text="🔍 Khám phá" />
         </children>
      </VBox>
   </left>

   <center>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="20.0" style="-fx-border-color: transparent transparent #2a2a35 transparent; -fx-border-width: 1;">
               <padding><Insets left="30.0" right="30.0" /></padding>
               <children>
                  <Label style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" text="Trang chủ" />
                  <Region HBox.hgrow="ALWAYS" />
                  <TextField prefWidth="300.0" promptText="Tìm kiếm sản phẩm đấu giá" style="-fx-background-color: #21212e; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8 15 8 15;" />
               </children>
            </HBox>

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #0f0f13;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
               <content>
                  <VBox spacing="20.0">
                     <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
                     <children>
                        <Label style="-fx-text-fill: white; -fx-font-size: 18px;" text="Phiên đấu giá nổi bật" />

                        <FlowPane fx:id="productContainer" hgap="20.0" vgap="20.0" />

                     </children>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </center>
</BorderPane>
