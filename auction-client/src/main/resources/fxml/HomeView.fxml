<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>
<?import java.lang.String?>

<VBox maxWidth="1.7976931348623157E308" spacing="35.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.edu.vnu.uet.group8.client.controller.HomeController">
   <children>

      <StackPane prefHeight="240.0" style="-fx-background-color: linear-gradient(to bottom right, #1e293b, #0f172a); -fx-background-radius: 24px; -fx-border-color: rgba(255,255,255,0.15); -fx-border-width: 1.5px; -fx-border-radius: 24px;">
         <effect>
            <DropShadow blurType="GAUSSIAN" offsetY="8.0" radius="16.0">
               <color><Color opacity="0.15" /></color>
            </DropShadow>
         </effect>
         <children>
            <VBox style="-fx-background-color: transparent; -fx-background-image: url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAoAAAAKCAYAAACNMs+9AAAAAXNSR0IArs4c6QAAACVJREFUKFNjZCASMDKgAnv37v3PTEq8oaEBVTEuORR51FCRQDUZAH3XBgXU/p34AAAAAElFTkSuQmCC'); -fx-opacity: 0.05;" />
            
            <HBox alignment="CENTER_LEFT" spacing="20.0">
               <padding>
                  <Insets bottom="30.0" left="45.0" right="45.0" top="30.0" />
               </padding>
               <children>
                  <VBox alignment="CENTER_LEFT" spacing="12.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-background-color: rgba(249, 115, 22, 0.2); -fx-text-fill: #f97316; -fx-padding: 4 12 4 12; -fx-background-radius: 12px; -fx-font-weight: bold; -fx-font-size: 12px; -fx-border-color: rgba(249, 115, 22, 0.4); -fx-border-radius: 12px;" text="🔥 PHIÊN ĐẤU GIÁ TÂM ĐIỂM" />
                        
                        <Label fx:id="lblHeroName" style="-fx-text-fill: #ffffff; -fx-font-size: 28px; -fx-font-weight: 900;" text="Đồng hồ Patek Philippe Nautilus 5711" wrapText="true" />
                        
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                           <children>
                              <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 14px;" text="Giá cao nhất hiện tại:" />
                              <Label fx:id="lblHeroPrice" style="-fx-text-fill: #fcd34d; -fx-font-size: 20px; -fx-font-weight: bold;" text="1,250,000,000 VNĐ" />
                              <Region minWidth="20.0" />
                              <Label fx:id="lblHeroTimer" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: #ffffff; -fx-padding: 6 14 6 14; -fx-background-radius: 20px; -fx-font-weight: bold; -fx-font-size: 13px;" text="⏳ Còn lại: 02:45:12" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  
                  <Button mnemonicParsing="false" onAction="#onHeroJoinClick" prefHeight="55.0" prefWidth="200.0" style="-fx-background-color: linear-gradient(to bottom, #ff9233 0%, #f97316 50%, #ea580c 100%); -fx-text-fill: #ffffff; -fx-background-radius: 14px; -fx-font-weight: bold; -fx-font-size: 16px; -fx-cursor: hand;" text="Tham gia ngay">
                     <effect>
                        <DropShadow blurType="GAUSSIAN" offsetY="4.0" radius="10.0">
                           <color><Color red="0.9" green="0.45" blue="0.08" opacity="0.6" /></color>
                        </DropShadow>
                     </effect>
                  </Button>
               </children>
            </HBox>
         </children>
      </StackPane>

      <VBox spacing="15.0" styleClass="home-category-container">
         <effect>
            <DropShadow blurType="GAUSSIAN" offsetY="8.0" radius="16.0">
               <color><Color opacity="0.15" /></color>
            </DropShadow>
         </effect>
         <children>
            <Label styleClass="text-heading" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Khám phá danh mục" />
            
            <!-- ScrollPane bao ngoài để hỗ trợ cửa sổ nhỏ -->
            <ScrollPane fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER"
                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
               <content>
                  <!-- Container luôn centered -->
                  <VBox alignment="CENTER" spacing="16.0" style="-fx-background-color: transparent;">
                     <!-- Hàng 1: 5 danh mục đầu -->
                     <HBox alignment="CENTER" spacing="16.0">
                        <Button mnemonicParsing="false" onAction="#onCategoryClick" userData="WATCHES"
                                prefHeight="90.0" prefWidth="160.0" minWidth="140.0"
                                styleClass="category-btn"
                                text="⌚&#10;Đồng hồ cao cấp" textAlignment="CENTER">
                           <font><Font name="System Bold" size="13.0" /></font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#onCategoryClick" userData="ELECTRONICS"
                                prefHeight="90.0" prefWidth="160.0" minWidth="140.0"
                                styleClass="category-btn"
                                text="💻&#10;Điện tử" textAlignment="CENTER">
                           <font><Font name="System Bold" size="13.0" /></font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#onCategoryClick" userData="JEWELRY"
                                prefHeight="90.0" prefWidth="160.0" minWidth="140.0"
                                styleClass="category-btn"
                                text="💎&#10;Trang sức" textAlignment="CENTER">
                           <font><Font name="System Bold" size="13.0" /></font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#onCategoryClick" userData="ART"
                                prefHeight="90.0" prefWidth="160.0" minWidth="140.0"
                                styleClass="category-btn"
                                text="🎨&#10;Nghệ thuật" textAlignment="CENTER">
                           <font><Font name="System Bold" size="13.0" /></font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#onCategoryClick" userData="VEHICLES"
                                prefHeight="90.0" prefWidth="160.0" minWidth="140.0"
                                styleClass="category-btn"
                                text="🚗&#10;Xe cộ" textAlignment="CENTER">
                           <font><Font name="System Bold" size="13.0" /></font>
                        </Button>
                     </HBox>
                     <!-- Hàng 2: 5 danh mục sau -->
                     <HBox alignment="CENTER" spacing="16.0">
                        <Button mnemonicParsing="false" onAction="#onCategoryClick" userData="BOOKS"
                                prefHeight="90.0" prefWidth="160.0" minWidth="140.0"
                                styleClass="category-btn"
                                text="📚&#10;Sách quý" textAlignment="CENTER">
                           <font><Font name="System Bold" size="13.0" /></font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#onCategoryClick" userData="ANTIQUES"
                                prefHeight="90.0" prefWidth="160.0" minWidth="140.0"
                                styleClass="category-btn"
                                text="🏺&#10;Đồ cổ" textAlignment="CENTER">
                           <font><Font name="System Bold" size="13.0" /></font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#onCategoryClick" userData="FASHION"
                                prefHeight="90.0" prefWidth="160.0" minWidth="140.0"
                                styleClass="category-btn"
                                text="👗&#10;Thời trang" textAlignment="CENTER">
                           <font><Font name="System Bold" size="13.0" /></font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#onCategoryClick" userData="REAL_ESTATE"
                                prefHeight="90.0" prefWidth="160.0" minWidth="140.0"
                                styleClass="category-btn"
                                text="🏢&#10;Bất động sản" textAlignment="CENTER">
                           <font><Font name="System Bold" size="13.0" /></font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#onCategoryClick" userData="OTHER"
                                prefHeight="90.0" prefWidth="160.0" minWidth="140.0"
                                styleClass="category-btn"
                                text="📦&#10;Khác" textAlignment="CENTER">
                           <font><Font name="System Bold" size="13.0" /></font>
                        </Button>
                     </HBox>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </VBox>

      <VBox fx:id="categoryContainer" spacing="30.0" VBox.vgrow="ALWAYS">
         <!-- Sections will be generated dynamically by HomeController -->
      </VBox>
      
      <Region minHeight="40.0" />

   </children>
</VBox>
