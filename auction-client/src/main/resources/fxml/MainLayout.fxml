<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="vn.edu.vnu.uet.group8.client.controller.MainController"
            prefWidth="1280" prefHeight="800"
            styleClass="app-bg">

    <stylesheets>
        <URL value="@../css/tokens.css"/>
        <URL value="@../css/components.css"/>
        <URL value="@../css/layout.css"/>
    </stylesheets>

    <!-- HEADER -->
    <top>
        <HBox styleClass="app-header" alignment="CENTER_LEFT" spacing="14">
            <padding><Insets top="10" bottom="10" left="16" right="16"/></padding>

            <!-- Hamburger toggle -->
            <Button fx:id="btnToggle" text="☰" onAction="#onToggleSidebar" styleClass="hamburger-btn"/>

            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" spacing="10" onMouseClicked="#onLogoClick" style="-fx-cursor: hand;">
                <ImageView fitWidth="36" fitHeight="36" preserveRatio="true">
                    <image><Image url="@../image/logo.png"/></image>
                </ImageView>
                <VBox>
                    <Label text="AUCTIVA" styleClass="logo-title"/>
                    <Label text="LIVE ONLINE AUCTIONS" styleClass="logo-subtitle"/>
                </VBox>
            </HBox>

            <!-- Search -->
            <TextField fx:id="tfSearch" promptText="Tìm kiếm sản phẩm đấu giá..."
                       maxWidth="280" HBox.hgrow="ALWAYS" styleClass="search-input"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Đấu giá link -->
            <Button fx:id="btnExplore" text="Đấu giá" onAction="#onExploreClick" styleClass="header-link"/>

            <!-- Trực tiếp link -->
            <Button fx:id="btnLive" text="● Trực tiếp" onAction="#onLiveClick" styleClass="header-link-live"/>

            <!-- Divider -->
            <Region prefWidth="1" prefHeight="24" styleClass="divider-v"/>

            <!-- Yêu thích -->
            <StackPane onMouseClicked="#onFavoriteClick" style="-fx-cursor: hand;">
                <Label text="♥" style="-fx-font-size: 20px; -fx-text-fill: #666;"/>
                <Label fx:id="lblFavCount" text="3" styleClass="badge-count" StackPane.alignment="TOP_RIGHT"/>
            </StackPane>

            <!-- Thông báo -->
            <StackPane onMouseClicked="#onNotificationClick" style="-fx-cursor: hand;">
                <Label text="🔔" style="-fx-font-size: 18px;"/>
                <Label fx:id="lblNotiCount" text="5" styleClass="badge-count" StackPane.alignment="TOP_RIGHT"/>
            </StackPane>

            <!-- Avatar -->
            <Label fx:id="lblAvatar" text="N" onMouseClicked="#onProfileClick" styleClass="avatar"/>

        </HBox>
    </top>

    <!-- SIDEBAR -->
    <left>
        <VBox fx:id="sidebar" prefWidth="200" styleClass="app-sidebar">
            <padding><Insets top="14" bottom="14" left="12" right="12"/></padding>

            <Button fx:id="btnHome" text="🏠   Trang chủ" userData="HOME" onAction="#onNavClick"
                    maxWidth="Infinity" styleClass="nav-item-active"/>
            <Region prefHeight="4"/>
            <Button fx:id="btnMyAuctions" text="📋   Đấu giá của tôi" userData="MY_AUCTIONS" onAction="#onNavClick"
                    maxWidth="Infinity" styleClass="nav-item"/>
            <Region prefHeight="4"/>
            <Button fx:id="btnWallet" text="💰   Ví tiền" userData="WALLET" onAction="#onNavClick"
                    maxWidth="Infinity" styleClass="nav-item"/>
            <Region prefHeight="4"/>
            <Button fx:id="btnSeller" text="🛒   Quản lý bán hàng" userData="SELLER" onAction="#onNavClick"
                    maxWidth="Infinity" styleClass="nav-item"/>

            <Region prefHeight="12"/>
            <Region prefHeight="1" styleClass="divider-h"/>
            <Region prefHeight="12"/>

            <Button fx:id="btnSettings" text="⚙️   Cài đặt" userData="SETTINGS" onAction="#onNavClick"
                    maxWidth="Infinity" styleClass="nav-item"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="🚪   Đăng xuất" onAction="#onLogout"
                    maxWidth="Infinity" styleClass="nav-item-logout"/>
        </VBox>
    </left>

    <!-- CONTENT -->
    <center>
        <StackPane fx:id="contentPane" styleClass="app-bg"/>
    </center>

</BorderPane>