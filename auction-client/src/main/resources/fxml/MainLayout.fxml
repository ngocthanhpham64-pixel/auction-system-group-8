<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<StackPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="700.0" minWidth="1024.0" styleClass="app-background" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.edu.vnu.uet.group8.client.controller.MainController">

    <BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">

        <left>
            <VBox fx:id="sidebar" maxHeight="1.7976931348623157E308" prefWidth="232.0" styleClass="sidebar-bg" BorderPane.alignment="CENTER">
                <effect>
                    <DropShadow blurType="GAUSSIAN" radius="18.0" spread="0.12">
                        <color><Color opacity="0.35" /></color>
                    </DropShadow>
                </effect>
                <BorderPane.margin><Insets top="72.0" /></BorderPane.margin>
                <Region minHeight="20.0" prefHeight="20.0" />

                <VBox spacing="2.0">
                    <padding><Insets bottom="8.0" left="22.0" right="22.0" top="8.0" /></padding>
                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: bold;" text="Phiên đang mở" />
                    <Label fx:id="lblOngoingCount" style="-fx-text-fill: #ffffff; -fx-font-size: 24px; -fx-font-weight: bold;" text="0" />
                </VBox>

                <Button fx:id="btnBidNow" mnemonicParsing="false" onAction="#onNavClick" prefHeight="40.0" prefWidth="188.0" style="-fx-background-color: linear-gradient(to bottom, #ff9233 0%, #f97316 50%, #ea580c 100%);                            -fx-text-fill: white; -fx-background-radius: 10px;                            -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;" text="Đấu giá ngay" userData="LIVE">
                    <VBox.margin><Insets bottom="14.0" left="22.0" right="22.0" top="4.0" /></VBox.margin>
                    <effect>
                        <DropShadow blurType="GAUSSIAN" offsetY="3.0" radius="8.0">
                            <color><Color red="0.9" green="0.45" blue="0.08" opacity="0.45" /></color>
                        </DropShadow>
                    </effect>
                </Button>

                <Button fx:id="btnHome" mnemonicParsing="false" onAction="#onNavClick" prefHeight="46.0" prefWidth="232.0" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 10 22 10 22; -fx-font-size: 14px; -fx-cursor: hand;" styleClass="nav-btn" text="🏠  Trang chủ" userData="HOME" />
                <Button fx:id="btnExplore" mnemonicParsing="false" onAction="#onNavClick" prefHeight="46.0" prefWidth="232.0" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 10 22 10 22; -fx-font-size: 14px; -fx-cursor: hand;" styleClass="nav-btn" text="🔍  Khám phá" userData="EXPLORE" />
                <Button fx:id="btnMyProducts" mnemonicParsing="false" onAction="#onNavClick" prefHeight="46.0" prefWidth="232.0" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 10 22 10 22; -fx-font-size: 14px; -fx-cursor: hand;" styleClass="nav-btn" text="📦  Sản phẩm của tôi" userData="SELLER" />
                
                <Button fx:id="btnAccount" mnemonicParsing="false" onAction="#onNavClick" prefHeight="46.0" prefWidth="232.0" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 10 22 10 22; -fx-font-size: 14px; -fx-cursor: hand;" styleClass="nav-btn" text="👤  Tài khoản của tôi" userData="PROFILE" />
                
                <Button fx:id="btnSettings" mnemonicParsing="false" onAction="#onNavClick" prefHeight="46.0" prefWidth="232.0" style="-fx-background-color: transparent; -fx-alignment: center-left; -fx-padding: 10 22 10 22; -fx-font-size: 14px; -fx-cursor: hand;" styleClass="nav-btn" text="⚙  Cài đặt" userData="SETTINGS" />

                <Region VBox.vgrow="ALWAYS" />

                <Button fx:id="btnLogout" mnemonicParsing="false" onAction="#onLogout" prefHeight="48.0" prefWidth="232.0" style="-fx-background-color: transparent; -fx-text-fill: #f87171;                                -fx-alignment: center-left; -fx-padding: 10 22 18 22;                                -fx-font-size: 14; -fx-cursor: hand;" text="↩️  Đăng xuất" />
            </VBox>
        </left>

        <center>
            <ScrollPane fitToHeight="false" fitToWidth="true" hbarPolicy="NEVER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">

                <content>
                    <VBox fx:id="vboxMainContentArea" maxWidth="1.7976931348623157E308" minWidth="820.0" style="-fx-padding: 80 36 36 36; -fx-background-color: transparent;">
                        </VBox>
                </content>
            </ScrollPane>
        </center>
    </BorderPane>

    <HBox alignment="CENTER_LEFT" maxHeight="72.0" minHeight="72.0" prefHeight="72.0" styleClass="header-bg" StackPane.alignment="TOP_CENTER">

        <HBox alignment="CENTER_LEFT" minWidth="232.0" prefWidth="232.0" style="-fx-padding: 0 0 0 24;">
         <ImageView fitHeight="50.0" fitWidth="50.0">
            <image>
               <Image url="@../image/logo.png" />
            </image>
         </ImageView>
         <Region prefHeight="70.0" prefWidth="28.0" />
            <Label onMouseClicked="#onLogoClick" style="-fx-font-weight: bold;                        -fx-font-size: 26px;                        -fx-text-fill: linear-gradient(to bottom right, #f97316, #ea580c);                        -fx-cursor: hand;" text="Auctiva" />
        </HBox>

        <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 0 16;" HBox.hgrow="ALWAYS">
            <TextField fx:id="tfSearch" maxWidth="480.0" prefHeight="38.0" prefWidth="280.0" promptText="Tìm kiếm sản phẩm, phiên đấu giá..." style="-fx-background-radius: 20px; -fx-border-radius: 20px; -fx-padding: 7 20; -fx-font-size: 13px;" styleClass="search-input" HBox.hgrow="ALWAYS" />
        </HBox>

        <HBox alignment="CENTER_RIGHT" prefHeight="72.0" spacing="22.0" style="-fx-padding: 0 36 0 0;">
            <StackPane maxHeight="40.0" minHeight="40.0" onMouseClicked="#onFavoriteClick" style="-fx-cursor: hand;">
                <Label fx:id="lblFavCount" style="-fx-background-color: #f97316; -fx-text-fill: white; -fx-font-size: 9px; -fx-padding: 1 4; -fx-background-radius: 10;" text="0" StackPane.alignment="TOP_RIGHT">
                    <StackPane.margin><Insets right="-4" top="-4" /></StackPane.margin>
                </Label>
                <Label fx:id="lblNavFavorites" style="-fx-font-size: 19px;" styleClass="text-sub" text="❤" />
            </StackPane>

            <StackPane maxHeight="40.0" minHeight="40.0" onMouseClicked="#onNotificationClick" style="-fx-cursor: hand;">
                <Label fx:id="lblNavNotifications" style="-fx-font-size: 19px;" styleClass="text-sub" text="🔔" />
                <Label fx:id="lblNotiCount" style="-fx-background-color: #f97316; -fx-text-fill: white; -fx-font-size: 9px; -fx-padding: 1 4; -fx-background-radius: 10;" text="0" StackPane.alignment="TOP_RIGHT">
                    <StackPane.margin><Insets right="-4" top="-4" /></StackPane.margin>
                </Label>
            </StackPane>

            <StackPane fx:id="paneNavAvatar" maxHeight="42.0" minHeight="42.0" minWidth="42.0" onMouseClicked="#onProfileClick" prefHeight="42.0" prefWidth="42.0" style="-fx-background-color: linear-gradient(to bottom right, #f97316, #ea580c);                        -fx-background-radius: 50px;                        -fx-border-color: rgba(255,255,255,0.9);                        -fx-border-width: 2px; -fx-border-radius: 50px; -fx-cursor: hand;">
                <Label fx:id="lblAvatar" style="-fx-text-fill: white;" text="?">
                    <font><Font name="System Bold" size="15.0" /></font>
                </Label>
                <ImageView fx:id="imgAvatar" fitHeight="42.0" fitWidth="42.0" pickOnBounds="true" preserveRatio="true" visible="false" />
            </StackPane>
        </HBox>
    </HBox>
</StackPane>
