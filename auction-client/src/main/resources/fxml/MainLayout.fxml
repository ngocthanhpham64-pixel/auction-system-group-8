<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="vn.edu.vnu.uet.group8.client.controller.MainController"
            prefWidth="1280" prefHeight="800"
            style="-fx-background-color: #F0F2F5;">

    <!-- SIDEBAR trái -->
    <left>
        <VBox fx:id="sidebar" prefWidth="220"
              style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 2, 0);">
            <padding>
                <Insets top="16" bottom="24" left="16" right="16"/>
            </padding>

            <!-- Nút hamburger ☰ -->
            <Button fx:id="btnToggle" text="☰"
                    onAction="#onToggleSidebar"
                    style="-fx-background-color: transparent; -fx-text-fill: #1E3A6E; -fx-font-size: 20px; -fx-cursor: hand; -fx-padding: 4 8; -fx-background-radius: 8;"
                    maxWidth="Infinity" alignment="CENTER_LEFT"/>

            <Region prefHeight="12"/>

            <!-- Logo -->
            <HBox fx:id="logoArea" alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 28 0;">
                <Label text="🔨"
                       style="-fx-background-color: #1E3A6E; -fx-background-radius: 8; -fx-padding: 6 8; -fx-font-size: 18px;"/>
                <VBox fx:id="logoText">
                    <Label text="AUCTIVA"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E3A6E;"/>
                    <Label text="LIVE ONLINE AUCTIONS"
                           style="-fx-font-size: 8px; -fx-text-fill: #F97316; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <!-- Nav buttons -->
            <Button fx:id="btnHome" text="🏠   Trang chủ"
                    userData="HOME" onAction="#onNavClick"
                    maxWidth="Infinity" style="-fx-background-color: #FFF3EB; -fx-text-fill: #F97316; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 16; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>
            <Region prefHeight="4"/>
            <Button fx:id="btnExplore" text="🔍   Khám phá"
                    userData="EXPLORE" onAction="#onNavClick"
                    maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #666; -fx-background-radius: 10; -fx-padding: 12 16; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>
            <Region prefHeight="4"/>
            <Button fx:id="btnMyAuctions" text="📋   Đấu giá của tôi"
                    userData="MY_AUCTIONS" onAction="#onNavClick"
                    maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #666; -fx-background-radius: 10; -fx-padding: 12 16; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>
            <Region prefHeight="4"/>
            <Button fx:id="btnWallet" text="💰   Ví tiền"
                    userData="WALLET" onAction="#onNavClick"
                    maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #666; -fx-background-radius: 10; -fx-padding: 12 16; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- Logout -->
            <Button text="🚪   Đăng xuất"
                    onAction="#onLogout"
                    maxWidth="Infinity" style="-fx-background-color: #FFF0F0; -fx-text-fill: #E03030; -fx-background-radius: 10; -fx-padding: 12 16; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>
        </VBox>
    </left>

    <!-- CONTENT -->
    <center>
        <StackPane fx:id="contentPane"
                   style="-fx-background-color: #F0F2F5;"/>
    </center>

</BorderPane>