<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vn.edu.vnu.uet.group8.client.controller.LiveAuctionController"
      style="-fx-background-color: #F8F8F8;"
      spacing="0">

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
        <content>
            <VBox spacing="14" style="-fx-padding: 20;">

                <!-- BANNER ĐANG DIỄN RA -->
                <HBox alignment="CENTER" spacing="6"
                      style="-fx-background-color: #FFE5E5; -fx-border-color: #FFB8B8; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10 14;">
                    <Label text="●" style="-fx-text-fill: #E03030; -fx-font-size: 9px;"/>
                    <Label text="ĐANG DIỄN RA - Phiên đấu giá trực tiếp"
                           style="-fx-text-fill: #E03030; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                </HBox>

                <HBox spacing="14">

                    <!-- CỘT TRÁI -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS">

                        <!-- Ảnh trực tiếp -->
                        <StackPane style="-fx-background-color: #FFF3EB; -fx-background-radius: 12;" prefHeight="240">
                            <ImageView fx:id="imgLive" fitWidth="400" fitHeight="240" preserveRatio="true"/>
                            <HBox spacing="6" alignment="CENTER" StackPane.alignment="TOP_LEFT" maxWidth="-Infinity" maxHeight="-Infinity"
                                  style="-fx-background-color: #E03030; -fx-background-radius: 6; -fx-padding: 3 10;">
                                <StackPane.margin><Insets top="10" left="10"/></StackPane.margin>
                                <Label text="●" style="-fx-text-fill: white; -fx-font-size: 9px;"/>
                                <Label text="TRỰC TIẾP" style="-fx-text-fill: white; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                            </HBox>
                            <Label fx:id="lblViewers" text="👥 342 người đang xem"
                                   style="-fx-background-color: rgba(0,0,0,0.7); -fx-text-fill: white; -fx-font-size: 11px; -fx-background-radius: 6; -fx-padding: 4 10;"
                                   StackPane.alignment="TOP_RIGHT" maxWidth="-Infinity" maxHeight="-Infinity">
                                <StackPane.margin><Insets top="10" right="10"/></StackPane.margin>
                            </Label>
                        </StackPane>

                        <!-- Thông tin sản phẩm -->
                        <VBox style="-fx-background-color: white; -fx-border-color: #EEEEEE; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 14;" spacing="6">
                            <Label fx:id="lblCategory" text="Đồng hồ cao cấp"
                                   style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-font-size: 9px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 2 8;"
                                   maxWidth="-Infinity"/>
                            <Label fx:id="lblProductName" text="Đồng Hồ Patek Philippe Nautilus Platinum"
                                   wrapText="true"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                            <Label fx:id="lblDescription" text="Đồng hồ Patek Philippe Nautilus phiên bản Platinum giới hạn, một trong những mẫu được săn đón nhất thế giới."
                                   wrapText="true"
                                   style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                        </VBox>

                        <!-- Chat trực tiếp -->
                        <VBox style="-fx-background-color: white; -fx-border-color: #EEEEEE; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 14;" spacing="10">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="💬 Trò chuyện trực tiếp"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="lblChatCount" text="6 tin nhắn"
                                       style="-fx-font-size: 11px; -fx-text-fill: #888;"/>
                            </HBox>

                            <ScrollPane prefHeight="160" fitToWidth="true"
                                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                                <content>
                                    <VBox fx:id="chatMessages" spacing="8">

                                        <!-- Message: Admin -->
                                        <HBox spacing="8" alignment="TOP_LEFT">
                                            <Label text="A"
                                                   style="-fx-background-color: #FFE5E5; -fx-text-fill: #E03030; -fx-font-size: 10px; -fx-font-weight: bold; -fx-background-radius: 50; -fx-min-width: 26; -fx-min-height: 26; -fx-alignment: CENTER;"/>
                                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <Label text="Admin" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
                                                    <Label text="Admin" style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-font-size: 8px; -fx-background-radius: 4; -fx-padding: 1 5;"/>
                                                    <Label text="10:30" style="-fx-font-size: 9px; -fx-text-fill: #888;"/>
                                                </HBox>
                                                <Label text="Chào mừng đến với phiên đấu giá!"
                                                       style="-fx-font-size: 11px; -fx-text-fill: #444;"/>
                                            </VBox>
                                        </HBox>

                                        <!-- Message: Collector88 -->
                                        <HBox spacing="8" alignment="TOP_LEFT">
                                            <Label text="C"
                                                   style="-fx-background-color: #E8F0FE; -fx-text-fill: #3B82F6; -fx-font-size: 10px; -fx-font-weight: bold; -fx-background-radius: 50; -fx-min-width: 26; -fx-min-height: 26; -fx-alignment: CENTER;"/>
                                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <Label text="Collector88" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
                                                    <Label text="10:31" style="-fx-font-size: 9px; -fx-text-fill: #888;"/>
                                                </HBox>
                                                <Label text="Đồng hồ này quá đẹp!" style="-fx-font-size: 11px; -fx-text-fill: #444;"/>
                                            </VBox>
                                        </HBox>

                                        <!-- Message: WatchLover -->
                                        <HBox spacing="8" alignment="TOP_LEFT">
                                            <Label text="W"
                                                   style="-fx-background-color: #F0FFF4; -fx-text-fill: #22C55E; -fx-font-size: 10px; -fx-font-weight: bold; -fx-background-radius: 50; -fx-min-width: 26; -fx-min-height: 26; -fx-alignment: CENTER;"/>
                                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <Label text="WatchLover" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
                                                    <Label text="10:32" style="-fx-font-size: 9px; -fx-text-fill: #888;"/>
                                                </HBox>
                                                <Label text="Giá đã tăng nhanh quá" style="-fx-font-size: 11px; -fx-text-fill: #444;"/>
                                            </VBox>
                                        </HBox>

                                        <!-- Message: LuxuryFan -->
                                        <HBox spacing="8" alignment="TOP_LEFT">
                                            <Label text="L"
                                                   style="-fx-background-color: #FFF8E1; -fx-text-fill: #D4A853; -fx-font-size: 10px; -fx-font-weight: bold; -fx-background-radius: 50; -fx-min-width: 26; -fx-min-height: 26; -fx-alignment: CENTER;"/>
                                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <Label text="LuxuryFan" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
                                                    <Label text="10:33" style="-fx-font-size: 9px; -fx-text-fill: #888;"/>
                                                </HBox>
                                                <Label text="Phiên bản platinum rất hiếm" style="-fx-font-size: 11px; -fx-text-fill: #444;"/>
                                            </VBox>
                                        </HBox>

                                        <!-- Message: VIPBidder -->
                                        <HBox spacing="8" alignment="TOP_LEFT">
                                            <Label text="V"
                                                   style="-fx-background-color: #FFF3EB; -fx-text-fill: #F97316; -fx-font-size: 10px; -fx-font-weight: bold; -fx-background-radius: 50; -fx-min-width: 26; -fx-min-height: 26; -fx-alignment: CENTER;"/>
                                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                                <HBox spacing="6" alignment="CENTER_LEFT">
                                                    <Label text="VIPBidder" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
                                                    <Label text="10:35" style="-fx-font-size: 9px; -fx-text-fill: #888;"/>
                                                </HBox>
                                                <Label text="Tôi quyết tâm sở hữu chiếc này" style="-fx-font-size: 11px; -fx-text-fill: #444;"/>
                                            </VBox>
                                        </HBox>

                                    </VBox>
                                </content>
                            </ScrollPane>

                            <!-- Input chat -->
                            <HBox spacing="6" style="-fx-padding: 10 0 0 0; -fx-border-color: #F0F0F0; -fx-border-width: 1 0 0 0;">
                                <TextField fx:id="tfChatInput" promptText="Nhập tin nhắn..."
                                           HBox.hgrow="ALWAYS"
                                           style="-fx-background-color: #F9F9F9; -fx-border-color: #E5E5E5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 11px; -fx-padding: 7 12;"/>
                                <Button text="➤" onAction="#onSendMessage"
                                        style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 7 14; -fx-cursor: hand;"/>
                            </HBox>
                        </VBox>

                    </VBox>

                    <!-- CỘT PHẢI -->
                    <VBox spacing="10" prefWidth="320">

                        <!-- Đồng hồ đếm ngược -->
                        <VBox style="-fx-background-color: #FFF3EB; -fx-background-radius: 12; -fx-padding: 14;" alignment="CENTER" spacing="6">
                            <Label text="⏱ Thời gian còn lại"
                                   style="-fx-font-size: 11px; -fx-text-fill: #888;" maxWidth="Infinity" alignment="CENTER"/>
                            <HBox alignment="CENTER" spacing="8">
                                <VBox alignment="CENTER" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #FFD4B8; -fx-border-radius: 8; -fx-padding: 8 14;">
                                    <Label fx:id="lblMinutes" text="8"
                                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #E03030;"/>
                                    <Label text="Phút" style="-fx-font-size: 9px; -fx-text-fill: #888;"/>
                                </VBox>
                                <VBox alignment="CENTER" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #FFD4B8; -fx-border-radius: 8; -fx-padding: 8 14;">
                                    <Label fx:id="lblSeconds" text="25"
                                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #E03030;"/>
                                    <Label text="Giây" style="-fx-font-size: 9px; -fx-text-fill: #888;"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Giá hiện tại -->
                        <VBox style="-fx-background-color: white; -fx-border-color: #EEEEEE; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 14;" spacing="2">
                            <Label text="Giá hiện tại" style="-fx-font-size: 10px; -fx-text-fill: #888;"/>
                            <Label fx:id="lblCurrentPrice" text="1.860.000.000 đ"
                                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #F97316;"/>
                            <Label fx:id="lblPriceChange" text="Tăng 10.000.000 đ so với lần trước"
                                   style="-fx-font-size: 10px; -fx-text-fill: #888;"/>
                        </VBox>

                        <!-- Đấu giá nhanh -->
                        <VBox style="-fx-background-color: white; -fx-border-color: #EEEEEE; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12;" spacing="8">
                            <Label text="⚡ Đấu giá nhanh"
                                   style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                            <TextField fx:id="tfBidAmount" promptText="1.870.000.000 đ"
                                       style="-fx-background-color: #F5F5F5; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 12px; -fx-padding: 8 12;"/>

                            <GridPane hgap="6" vgap="6">
                                <Button text="+10M" onAction="#onQuickBid1" GridPane.columnIndex="0" GridPane.rowIndex="0" maxWidth="Infinity"
                                        style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-text-fill: #1a1a1a; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 11px; -fx-cursor: hand; -fx-padding: 6;"/>
                                <Button text="+20M" onAction="#onQuickBid2" GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="Infinity"
                                        style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-text-fill: #1a1a1a; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 11px; -fx-cursor: hand; -fx-padding: 6;"/>
                                <Button text="+50M" onAction="#onQuickBid3" GridPane.columnIndex="0" GridPane.rowIndex="1" maxWidth="Infinity"
                                        style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-text-fill: #1a1a1a; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 11px; -fx-cursor: hand; -fx-padding: 6;"/>
                                <Button text="+100M" onAction="#onQuickBid4" GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="Infinity"
                                        style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-text-fill: #1a1a1a; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 11px; -fx-cursor: hand; -fx-padding: 6;"/>
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50"/>
                                    <ColumnConstraints percentWidth="50"/>
                                </columnConstraints>
                            </GridPane>

                            <Button text="🔨 Đặt giá ngay" onAction="#onBidNow"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: #E03030; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10; -fx-cursor: hand;"/>
                        </VBox>

                        <!-- Lịch sử đấu giá -->
                        <VBox style="-fx-background-color: white; -fx-border-color: #EEEEEE; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12;" spacing="6">
                            <Label text="Lịch sử đấu giá trực tiếp"
                                   style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a; -fx-padding: 0 0 4 0;"/>

                            <VBox fx:id="bidHistory" spacing="5">

                                <!-- Đang dẫn đầu -->
                                <HBox style="-fx-background-color: #F0FFF4; -fx-background-radius: 8; -fx-padding: 8 10;" alignment="CENTER_LEFT">
                                    <VBox HBox.hgrow="ALWAYS" spacing="2">
                                        <Label text="Người dùng 8432"
                                               style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                                        <Label text="Đang dẫn đầu"
                                               style="-fx-background-color: #22C55E; -fx-text-fill: white; -fx-font-size: 8px; -fx-background-radius: 4; -fx-padding: 1 5;" maxWidth="-Infinity"/>
                                        <Label text="Vừa xong" style="-fx-font-size: 9px; -fx-text-fill: #888;"/>
                                    </VBox>
                                    <Label text="1.860.000.000 đ"
                                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                                </HBox>

                                <!-- Bạn -->
                                <HBox style="-fx-background-color: #E8F0FE; -fx-background-radius: 8; -fx-padding: 8 10;" alignment="CENTER_LEFT">
                                    <VBox HBox.hgrow="ALWAYS" spacing="2">
                                        <Label text="Bạn"
                                               style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                                        <Label text="Lượt của bạn"
                                               style="-fx-background-color: #3B82F6; -fx-text-fill: white; -fx-font-size: 8px; -fx-background-radius: 4; -fx-padding: 1 5;" maxWidth="-Infinity"/>
                                        <Label text="45 giây trước" style="-fx-font-size: 9px; -fx-text-fill: #888;"/>
                                    </VBox>
                                    <Label text="1.840.000.000 đ"
                                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                                </HBox>

                                <!-- Người khác -->
                                <HBox style="-fx-background-color: #FAFAFA; -fx-background-radius: 8; -fx-padding: 8 10;" alignment="CENTER_LEFT">
                                    <VBox HBox.hgrow="ALWAYS" spacing="2">
                                        <Label text="Người dùng 5671"
                                               style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                                        <Label text="1 phút trước" style="-fx-font-size: 9px; -fx-text-fill: #888;"/>
                                    </VBox>
                                    <Label text="1.830.000.000 đ"
                                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                                </HBox>

                                <HBox style="-fx-background-color: #FAFAFA; -fx-background-radius: 8; -fx-padding: 8 10;" alignment="CENTER_LEFT">
                                    <VBox HBox.hgrow="ALWAYS" spacing="2">
                                        <Label text="Người dùng 9234"
                                               style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                                        <Label text="2 phút trước" style="-fx-font-size: 9px; -fx-text-fill: #888;"/>
                                    </VBox>
                                    <Label text="1.820.000.000 đ"
                                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                                </HBox>

                            </VBox>
                        </VBox>

                    </VBox>
                </HBox>

            </VBox>
        </content>
    </ScrollPane>
</VBox>