<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vn.edu.vnu.uet.group8.client.controller.AuctionDetailController"
      styleClass="app-bg"
      spacing="0">

    <stylesheets>
        <URL value="@../css/tokens.css"/>
        <URL value="@../css/components.css"/>
        <URL value="@../css/layout.css"/>
    </stylesheets>

    <!-- NÚT QUAY LẠI -->
    <HBox style="-fx-padding: 16 24 8 24;">
        <Button text="← Quay lại danh sách" onAction="#onBack"
                style="-fx-background-color: transparent; -fx-text-fill: #666; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 6 0;"/>
    </HBox>

    <!-- NỘI DUNG CHÍNH -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scrollpane-clean">
        <content>
            <HBox spacing="20" style="-fx-padding: 0 24 24 24;">

                <!-- CỘT TRÁI -->
                <VBox spacing="12" HBox.hgrow="ALWAYS">

                    <!-- Ảnh chính -->
                    <StackPane styleClass="card-bg-orange" prefHeight="220">
                        <ImageView fx:id="imgMain" fitWidth="300" fitHeight="220" preserveRatio="true"/>
                        <Label fx:id="lblCategory" text="Đồng hồ cao cấp" styleClass="badge-category"
                               StackPane.alignment="TOP_LEFT" maxWidth="-Infinity" maxHeight="-Infinity">
                            <StackPane.margin><Insets top="8" left="8"/></StackPane.margin>
                        </Label>
                        <HBox spacing="6" StackPane.alignment="TOP_RIGHT" maxWidth="-Infinity" maxHeight="-Infinity">
                            <StackPane.margin><Insets top="8" right="8"/></StackPane.margin>
                            <Button text="♥" onAction="#onFavorite"
                                    style="-fx-background-color: white; -fx-background-radius: 50; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 4 8; -fx-min-width: 32; -fx-min-height: 32;"/>
                            <Button text="⤴" onAction="#onShare"
                                    style="-fx-background-color: white; -fx-background-radius: 50; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 4 8; -fx-min-width: 32; -fx-min-height: 32;"/>
                        </HBox>
                    </StackPane>

                    <!-- Ảnh thumbnail -->
                    <HBox spacing="8">
                        <Button fx:id="btnThumb1" onAction="#onThumb1"
                                style="-fx-background-color: #FFF3EB; -fx-background-radius: 8; -fx-border-color: #F97316; -fx-border-radius: 8; -fx-border-width: 2; -fx-pref-width: 60; -fx-pref-height: 50; -fx-cursor: hand;"/>
                        <Button fx:id="btnThumb2" onAction="#onThumb2"
                                style="-fx-background-color: #F5F5F5; -fx-background-radius: 8; -fx-pref-width: 60; -fx-pref-height: 50; -fx-cursor: hand;"/>
                        <Button fx:id="btnThumb3" onAction="#onThumb3"
                                style="-fx-background-color: #F5F5F5; -fx-background-radius: 8; -fx-pref-width: 60; -fx-pref-height: 50; -fx-cursor: hand;"/>
                    </HBox>

                    <!-- TABS MÔ TẢ -->
                    <VBox style="-fx-background-color: white; -fx-border-color: #EEEEEE; -fx-border-radius: 12; -fx-background-radius: 12;">

                        <!-- Tab buttons -->
                        <HBox>
                            <Button fx:id="btnTabDesc" text="Mô tả" onAction="#onTabDesc"
                                    maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                    style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 12 0 0 0; -fx-padding: 10; -fx-cursor: hand;"/>
                            <Button fx:id="btnTabSpec" text="Thông số" onAction="#onTabSpec"
                                    maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                    style="-fx-background-color: #F5F5F5; -fx-text-fill: #666; -fx-font-size: 12px; -fx-padding: 10; -fx-cursor: hand;"/>
                            <Button fx:id="btnTabOrigin" text="Nguồn gốc" onAction="#onTabOrigin"
                                    maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                    style="-fx-background-color: #F5F5F5; -fx-text-fill: #666; -fx-font-size: 12px; -fx-background-radius: 0 12 0 0; -fx-padding: 10; -fx-cursor: hand;"/>
                        </HBox>

                        <!-- Nội dung tab -->
                        <VBox style="-fx-padding: 14;">
                            <VBox fx:id="paneDesc" spacing="8">
                                <Label fx:id="lblDescription" text="Đồng hồ Rolex Submariner cổ điển từ thập niên 1960, được bảo quản trong tình trạng tuyệt vời."
                                       wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #333;"/>
                                <Label text="Tình trạng" styleClass="text-bold" style="-fx-font-size: 13px;"/>
                                <Label fx:id="lblCondition" text="Tuyệt vời - đã qua phục chế chuyên nghiệp"
                                       style="-fx-font-size: 13px; -fx-text-fill: #666;"/>
                            </VBox>

                            <VBox fx:id="paneSpec" spacing="8" visible="false" managed="false">
                                <HBox><Label text="Thương hiệu" styleClass="label-info" style="-fx-pref-width: 120;"/><Label fx:id="lblBrand" text="Rolex" style="-fx-font-size: 12px;"/></HBox>
                                <HBox><Label text="Model" styleClass="label-info" style="-fx-pref-width: 120;"/><Label fx:id="lblModel" text="Submariner 5513" style="-fx-font-size: 12px;"/></HBox>
                                <HBox><Label text="Năm sản xuất" styleClass="label-info" style="-fx-pref-width: 120;"/><Label fx:id="lblYear" text="1965" style="-fx-font-size: 12px;"/></HBox>
                                <HBox><Label text="Chất liệu" styleClass="label-info" style="-fx-pref-width: 120;"/><Label fx:id="lblMaterial" text="Vàng 18k" style="-fx-font-size: 12px;"/></HBox>
                            </VBox>

                            <VBox fx:id="paneOrigin" spacing="8" visible="false" managed="false">
                                <Label fx:id="lblOrigin" text="Xuất xứ từ Thụy Sĩ, được mua lại từ nhà sưu tầm tư nhân tại Geneva năm 2018."
                                       wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #333;"/>
                                <Label fx:id="lblCertificate" text="Kèm theo giấy chứng nhận xác thực từ Rolex và biên lai mua hàng gốc."
                                       wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #666;"/>
                            </VBox>
                        </VBox>
                    </VBox>

                    <!-- LỊCH SỬ ĐẤU GIÁ -->
                    <VBox styleClass="card" spacing="8">
                        <Label text="Lịch sử đấu giá" styleClass="section-title" style="-fx-font-size: 14px;"/>
                        <ScrollPane prefHeight="180" fitToWidth="true" styleClass="scrollpane-clean">
                            <content>
                                <VBox fx:id="bidHistory" spacing="6"/>
                            </content>
                        </ScrollPane>
                    </VBox>

                </VBox>

                <!-- CỘT PHẢI -->
                <VBox spacing="12" prefWidth="320">

                    <Label fx:id="lblProductName" text="Đồng Hồ Rolex Submariner Vintage 1960s"
                           wrapText="true" styleClass="h3"/>
                    <Label fx:id="lblBidStats" text="48 lượt đấu giá  |  124 người theo dõi" styleClass="label-info"/>

                    <!-- Đồng hồ đếm ngược -->
                    <VBox styleClass="card-bg-orange" alignment="CENTER" spacing="8">
                        <Label text="Thời gian còn lại" styleClass="text-muted" maxWidth="Infinity" alignment="CENTER"/>
                        <HBox alignment="CENTER" spacing="12">
                            <VBox alignment="CENTER">
                                <Label fx:id="lblHours" text="02" styleClass="price-large"/>
                                <Label text="Giờ" styleClass="text-muted-sm"/>
                            </VBox>
                            <Label text=":" styleClass="price-large"/>
                            <VBox alignment="CENTER">
                                <Label fx:id="lblMinutes" text="14" styleClass="price-large"/>
                                <Label text="Phút" styleClass="text-muted-sm"/>
                            </VBox>
                            <Label text=":" styleClass="price-large"/>
                            <VBox alignment="CENTER">
                                <Label fx:id="lblSeconds" text="30" styleClass="price-large"/>
                                <Label text="Giây" styleClass="text-muted-sm"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Giá -->
                    <VBox styleClass="card" spacing="4">
                        <Label text="Giá hiện tại" styleClass="text-muted"/>
                        <Label fx:id="lblCurrentPrice" text="850.000.000 đ" styleClass="price-large"/>
                        <Label fx:id="lblStartPrice" text="Giá khởi điểm: 500.000.000 đ" styleClass="text-muted"/>
                    </VBox>

                    <!-- ĐẶT GIÁ -->
                    <VBox styleClass="card" spacing="8">
                        <Label text="Đặt giá đấu" styleClass="section-title" style="-fx-font-size: 12px;"/>
                        <TextField fx:id="tfBidAmount" promptText="860.000.000 đ" styleClass="form-input"/>
                        <HBox>
                            <Label fx:id="lblMinBid" text="Mức tăng tối thiểu: 10.000.000 đ" styleClass="text-muted"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblStep" text="Bước nhảy: 10.000.000 đ" styleClass="text-muted"/>
                        </HBox>

                        <HBox spacing="6">
                            <Button text="+10.000.000" onAction="#onQuickBid1" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                    style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 11px; -fx-cursor: hand; -fx-padding: 6 4;"/>
                            <Button text="+20.000.000" onAction="#onQuickBid2" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                    style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 11px; -fx-cursor: hand; -fx-padding: 6 4;"/>
                            <Button text="+50.000.000" onAction="#onQuickBid3" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                    style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 11px; -fx-cursor: hand; -fx-padding: 6 4;"/>
                        </HBox>

                        <Button text="Đặt giá ngay" onAction="#onBidNow" maxWidth="Infinity"
                                style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12; -fx-cursor: hand;"/>

                        <!-- Đặt giá tự động -->
                        <VBox style="-fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-background-radius: 8;">
                            <Button fx:id="btnAutoToggle" text="Đặt giá tự động  ▼" onAction="#onToggleAuto" maxWidth="Infinity"
                                    style="-fx-background-color: #F5F5F5; -fx-text-fill: #444; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 14; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>
                            <VBox fx:id="paneAuto" spacing="8" visible="false" managed="false"
                                  style="-fx-padding: 12 14; -fx-border-color: #E0E0E0; -fx-border-width: 1 0 0 0;">
                                <Label text="Hệ thống tự động tăng giá từng bước khi có người trả cao hơn, chỉ đủ để bạn dẫn đầu, đến mức tối đa bạn đặt."
                                       wrapText="true" styleClass="label-info"/>
                                <Label text="Giá tối đa sẵn sàng trả" styleClass="text-bold" style="-fx-font-size: 12px;"/>
                                <TextField fx:id="tfMaxPrice" promptText="Ví dụ: 900.000.000 đ" styleClass="form-input"/>
                                <Label fx:id="lblAutoStep" text="Bước nhảy tự động: 10.000.000 đ / lần" styleClass="text-muted"/>
                                <Button text="Kích hoạt đặt giá tự động" onAction="#onActivateAuto" maxWidth="Infinity"
                                        style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10; -fx-cursor: hand;"/>
                            </VBox>
                        </VBox>
                    </VBox>

                    <!-- Người bán -->
                    <VBox styleClass="card" spacing="10">
                        <Label text="Người bán" styleClass="section-title" style="-fx-font-size: 12px;"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label fx:id="lblSellerAvatar" text="LC" styleClass="avatar" style="-fx-min-width: 36; -fx-min-height: 36;"/>
                            <VBox>
                                <Label fx:id="lblSellerName" text="Luxury Watch Collector" styleClass="text-bold" style="-fx-font-size: 13px;"/>
                                <Label fx:id="lblSellerStats" text="4.9/5.0  |  156 giao dịch  |  Đã xác minh" styleClass="text-muted"/>
                            </VBox>
                        </HBox>
                    </VBox>

                </VBox>
            </HBox>
        </content>
    </ScrollPane>
</VBox>