<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefWidth="440.0" spacing="16.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.edu.vnu.uet.group8.client.controller.SuccessContentController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label style="-fx-font-size: 55px; -fx-text-fill: #16a34a;" text="✅" />
      
      <Label fx:id="lblSuccessTitle" styleClass="text-heading" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Thao tác thành công!" />
      
      <Label fx:id="lblSuccessMessage" styleClass="text-sub" style="-fx-font-size: 13px; -fx-text-alignment: center;" text="Dữ liệu đã được hệ thống xử lý và cập nhật an toàn." wrapText="true" />
      
      <VBox prefHeight="10.0" />
      
      <Button fx:id="btnDone" mnemonicParsing="false" onAction="#onDoneClick" prefHeight="40.0" prefWidth="160.0" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-font-size: 13px; -fx-cursor: hand;" text="Tuyệt vời" />
   </children>
</VBox>