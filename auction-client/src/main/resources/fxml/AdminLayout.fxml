<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.*?>
<?import java.net.URL?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="vn.edu.vnu.uet.group8.client.controller.AdminController"
            styleClass="app-background">
    <stylesheets>
        <URL value="@../css/components.css" />
    </stylesheets>

    <left>
        <VBox fx:id="sidebar"
              style="-fx-background-color: #0F172A; -fx-pref-width: 230; -fx-min-width: 230;
                     -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.18), 12, 0, 2, 0);"
              spacing="4">
            <padding>
                <Insets top="28" right="12" bottom="24" left="12"/>
            </padding>

            <!-- Logo block -->
            <VBox spacing="3" style="-fx-padding: 0 4 24 4;">
                <Label text="AUCTIVA"
                       style="-fx-text-fill: #F97316; -fx-font-weight: 900; -fx-font-size: 21px; -fx-letter-spacing: 1.5px;"/>
                <Label text="Hệ thống quản trị viên"
                       style="-fx-text-fill: #475569; -fx-font-size: 11px; -fx-font-weight: 500;"/>
            </VBox>

            <!-- Separator section label -->
            <Label text="TỔNG QUAN"
                   style="-fx-text-fill: #334155; -fx-font-size: 10px; -fx-font-weight: 700;
                          -fx-padding: 0 0 4 6; -fx-letter-spacing: 1px;"/>

            <!-- Nav buttons — active state quản lý qua AdminController.java -->
            <Button fx:id="btnDashboard" text="Tổng quan"
                    onAction="#showDashboard"
                    styleClass="nav-item, nav-item-active"
                    maxWidth="Infinity" alignment="CENTER_LEFT"/>

            <Label text="QUẢN LÝ"
                   style="-fx-text-fill: #334155; -fx-font-size: 10px; -fx-font-weight: 700;
                          -fx-padding: 12 0 4 6; -fx-letter-spacing: 1px;"/>

            <Button fx:id="btnUsers" text="Người dùng"
                    onAction="#showUsers"
                    styleClass="nav-item"
                    maxWidth="Infinity" alignment="CENTER_LEFT"/>
            <Button fx:id="btnAuctions" text="Phiên đấu giá"
                    onAction="#showAuctions"
                    styleClass="nav-item"
                    maxWidth="Infinity" alignment="CENTER_LEFT"/>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Divider trước logout -->
            <Separator style="-fx-background-color: #1E293B; -fx-opacity: 0.6;"/>

            <!-- Logout — dùng nav-item-danger thay vì override inline style -->
            <Button fx:id="btnLogout" text="Đăng xuất"
                    onAction="#exitAdmin"
                    styleClass="nav-item-danger"
                    maxWidth="Infinity" alignment="CENTER_LEFT"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentPane" styleClass="app-background"/>
    </center>

</BorderPane>
