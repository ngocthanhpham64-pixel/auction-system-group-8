<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="vn.edu.vnu.uet.group8.client.controller.AdminController"
            style="-fx-background-color: #F8F8F8;">
    <left>
        <VBox style="-fx-background-color: #2C3E50; -fx-pref-width: 220; -fx-padding: 20;" spacing="10">
            <Label text="QUẢN TRỊ HỆ THỐNG" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;"/>
            <Separator/>
            <Button text="📊 Tổng quan" onAction="#showDashboard"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand;"/>
            <Button text="👥 Người dùng" onAction="#showUsers"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand;"/>
            <Button text="🔨 Phiên đấu giá" onAction="#showAuctions"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand;"/>
            <Separator/>
            <Button text="🚪 Quay lại trang chính" onAction="#exitAdmin"
                    style="-fx-background-color: transparent; -fx-text-fill: #E03030; -fx-font-size: 14px; -fx-cursor: hand;"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentPane" style="-fx-background-color: #F8F8F8;"/>
    </center>
</BorderPane>