<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>
<?import java.lang.String?>

<!--
    ProductCard.fxml — FIX
    - prefWidth="260" + prefHeight="340": kích thước cố định để TilePane đồng đều
    - maxHeight="340" / minHeight="340": ngăn card bị co/dãn không đều
    - lblCategory + lblCondition đều có fx:id → Controller set được
    - Xóa lblPartnerBadge (không dùng)
    - productImage: fitWidth/Height khớp imageContainer để ảnh fill đúng
-->
<VBox fx:id="root"
      prefWidth="260"
      prefHeight="340"
      minHeight="340"
      maxHeight="340"
      spacing="0"
      style="-fx-cursor: hand;"
      onMouseClicked="#onCardClick"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vn.edu.vnu.uet.group8.client.controller.ProductCardController">
    <styleClass>
        <String fx:value="glass-card" />
        <String fx:value="product-card" />
    </styleClass>

    <stylesheets>
        <URL value="@../css/tokens.css"/>
        <URL value="@../css/components.css"/>
        <URL value="@../css/layout.css"/>
    </stylesheets>

    <!-- ── ẢNH SẢN PHẨM ── -->
    <StackPane fx:id="imageContainer"
               prefHeight="172" minHeight="172" maxHeight="172">
        <VBox.margin><Insets top="8" left="8" right="8"/></VBox.margin>

        <!-- Ảnh chính — Controller load từ URL -->
        <ImageView fx:id="productImage"
                   fitWidth="224" fitHeight="160"
                   pickOnBounds="true"
                   preserveRatio="true"
                   StackPane.alignment="CENTER"/>



        <!-- Badge trạng thái (LIVE / UPCOMING / ENDED) -->
        <Label fx:id="lblCertBadge"
               text="🔥 LIVE"
               visible="false" managed="false"
               style="-fx-background-color: #ef4444; -fx-text-fill: white;
                      -fx-font-size: 10px; -fx-font-weight: bold;
                      -fx-background-radius: 6; -fx-padding: 3 9;"
               StackPane.alignment="TOP_LEFT">
            <StackPane.margin><Insets top="10" left="10"/></StackPane.margin>
        </Label>

        <!-- Countdown timer -->
        <HBox alignment="CENTER" spacing="5"
              StackPane.alignment="TOP_RIGHT"
              maxWidth="-Infinity" maxHeight="-Infinity"
              style="-fx-background-color: rgba(15, 23, 42, 0.8); /* Màu Slate đen đậm đà */
                     -fx-background-radius: 0 16 0 12; /* Bo góc dưới mềm mại hơn */
                     -fx-padding: 5 10 5 10;">

            <StackPane.margin>
                <Insets top="0" right="0"/>
            </StackPane.margin>

            <Label text="⏳"
                   style="-fx-font-size: 11px; -fx-text-fill: #f59e0b;"/>

            <Label fx:id="lblTimer" text="04:57:14"
                   style="-fx-font-size: 12px;
                          -fx-font-weight: 800;
                          -fx-text-fill: #fbbf24; /* Màu vàng Gold sang trọng */
                          -fx-font-family: 'Monospaced'"/>
        </HBox>
    </StackPane>

    <!-- ── THÔNG TIN SẢN PHẨM ── -->
    <VBox spacing="7" style="-fx-padding: 12 14 14 14;" VBox.vgrow="ALWAYS">

        <!-- Category + Condition -->
        <HBox alignment="CENTER_LEFT">
            <Label fx:id="lblCategory" text="--"
                   style="-fx-text-fill: #6b7280; -fx-font-size: 10px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblCondition" text="Mới"
                   style="-fx-text-fill: #10b981; -fx-font-size: 10px; -fx-font-weight: bold;"/>
        </HBox>

        <!-- Tên sản phẩm: cố định 2 dòng để card đồng đều chiều cao -->
        <Label fx:id="productName"
               text="Đang tải..."
               wrapText="true"
               maxHeight="40" minHeight="40"
               styleClass="text-heading"
               style="-fx-font-size: 13px; -fx-font-weight: bold;"
               alignment="TOP_LEFT"/>

        <!-- Divider -->
        <Region prefHeight="1" styleClass="divider"/>

        <!-- Giá + Bid count -->
        <HBox alignment="BOTTOM_LEFT" spacing="6">
            <VBox spacing="1" HBox.hgrow="ALWAYS">
                <Label text="Giá hiện tại"
                       style="-fx-text-fill: #9ca3af; -fx-font-size: 9px;"/>
                <Label fx:id="currentPrice" text="0đ"
                       style="-fx-font-size: 15px; -fx-font-weight: 900; -fx-text-fill: #f97316;"/>
            </VBox>
            <Label fx:id="lblBidCount" text="0 bids"
                   style="-fx-text-fill: #6b7280; -fx-font-size: 10px;
                          -fx-background-color: #f3f4f6; -fx-padding: 2 7;
                          -fx-background-radius: 4;"/>
        </HBox>

        <!-- Nút CTA -->
        <Button fx:id="btnAction" styleClass="btn-card-cta" text="Xem đấu giá →" maxWidth="Infinity" onAction="#onCardClick">
            <VBox.margin><Insets top="3"/></VBox.margin>
        </Button>

    </VBox>
</VBox>
