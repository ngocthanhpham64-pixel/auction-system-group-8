<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vn.edu.vnu.uet.group8.client.controller.ProductCardController"
      styleClass="product-card"
      stylesheets="@../css/style.css"
      prefWidth="220" spacing="0">

   <!-- Image Area -->
   <StackPane styleClass="card-image-wrapper" prefHeight="160">
      <ImageView fx:id="ivProduct" fitWidth="220" fitHeight="160"
                 preserveRatio="false" styleClass="card-image"/>

      <!-- Status badge -->
      <Label fx:id="lblStatus" text="LIVE" styleClass="status-badge-live"
             StackPane.alignment="TOP_LEFT">
         <StackPane.margin><Insets top="10" left="10"/></StackPane.margin>
      </Label>

      <!-- Timer / countdown badge -->
      <HBox styleClass="timer-badge" alignment="CENTER"
            StackPane.alignment="BOTTOM_RIGHT">
         <StackPane.margin><Insets bottom="10" right="10"/></StackPane.margin>
         <Label fx:id="lblTimer" text="02:34:10" styleClass="timer-text"/>
      </HBox>
   </StackPane>

   <!-- Card Content -->
   <VBox styleClass="card-content" spacing="8">
      <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>

      <!-- Category tag -->
      <Label fx:id="lblCategory" text="Nghệ thuật" styleClass="card-category"/>

      <!-- Title -->
      <Label fx:id="lblName" text="Tên sản phẩm" styleClass="card-title"
             wrapText="true"/>

      <!-- Seller -->
      <HBox spacing="6" alignment="CENTER_LEFT">
         <Label text="👤" styleClass="card-seller-icon"/>
         <Label fx:id="lblSeller" text="Người bán" styleClass="card-seller"/>
      </HBox>

      <!-- Separator -->
      <Separator styleClass="card-sep"/>

      <!-- Bid info -->
      <VBox spacing="4">
         <Label text="Giá hiện tại" styleClass="bid-label"/>
         <Label fx:id="lblCurrentBid" text="0 ₫" styleClass="bid-amount"/>
      </VBox>

      <!-- Bid count and button row -->
      <HBox alignment="CENTER_LEFT" spacing="8">
         <VBox>
            <Label fx:id="lblBidCount" text="0 lượt đấu" styleClass="bid-count"/>
         </VBox>
         <Region HBox.hgrow="ALWAYS"/>
         <Button fx:id="btnBid" text="Đặt giá" styleClass="bid-btn"
                 onAction="#onBidNow"/>
      </HBox>
   </VBox>

</VBox>
